@{
    ViewData["Title"] = "Category";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen font-sans">
    <div class="container mx-auto p-6">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
            <header>
                <h1 class="text-3xl font-bold text-gray-700">Category Management</h1>
                <p class="text-gray-400 text-sm">Manage product categories and classifications</p>
            </header>
            <!-- Add Category Button -->
            <button id="addCategoryButton"
                    class="hover:bg-teal-700 bg-teal-600 text-white px-4 py-2 rounded-md shadow">
                + Add Category
            </button>
        </div>

        <!-- Stats -->
        <section class="grid grid-cols-1 sm:grid-cols-4 gap-6 mb-6">
            <div class="bg-white shadow-md rounded-lg p-6">
                <p class="text-sm text-gray-400">Total Categories</p>
                <p id="totalCategories" class="text-3xl font-bold text-purple-600">Loading...</p>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6">
                <p class="text-sm text-gray-400">Active Categories</p>
                <p id="activeCategories" class="text-3xl font-bold text-green-600">Loading...</p>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6">
                <p class="text-sm text-gray-400">Total Products</p>
                <p id="totalProducts" class="text-3xl font-bold text-blue-600">Loading...</p>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6">
                <p class="text-sm text-gray-400">Average Items</p>
                <p id="averageItems" class="text-3xl font-bold text-orange-600">Loading...</p>
            </div>
        </section>

        <!-- Categories Grid -->
        <section id="categoriesGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <!-- Categories will be loaded here -->
        </section>

        <!-- Loading State -->
        <div id="loadingState" class="text-center py-8">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-teal-600 mx-auto mb-4"></div>
            <p class="text-gray-600">Loading categories...</p>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="text-center py-8 hidden">
            <div class="text-gray-400 text-6xl mb-4">📦</div>
            <h3 class="text-xl font-semibold text-gray-600 mb-2">No Categories Found</h3>
            <p class="text-gray-500 mb-4">Start by creating your first category</p>
            <button onclick="document.getElementById('addCategoryButton').click()"
                    class="bg-teal-600 text-white px-4 py-2 rounded-md hover:bg-teal-700">
                Add Category
            </button>
        </div>
    </div>

    <!-- Modal Add Category -->
    <div id="addCategoryModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-2xl p-8 max-h-screen overflow-y-auto">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-gray-700">Add New Category</h2>
                <button id="closeAddModal" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>

            <form id="addCategoryForm" class="space-y-4">
                <!-- Image Upload -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Category Image</label>
                    <div id="imagePreview"
                         class="flex items-center justify-center w-full h-32 border-2 border-dashed border-gray-300 rounded-lg text-gray-400 bg-gray-50 hover:bg-gray-100 transition">
                        <div class="text-center">
                            <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <p id="defaultText" class="mt-2 text-sm">Upload an image or select a file</p>
                        </div>
                        <img id="uploadedImage" class="hidden w-full h-full object-cover rounded-lg" />
                    </div>
                    <input type="file" id="uploadImage" accept="image/*"
                           class="mt-3 w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100" />
                </div>

                <!-- Category Name & Description -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Category Name <span class="text-red-500">*</span></label>
                        <input id="categoryName" type="text"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                               placeholder="e.g., Server Equipment"
                               required />
                        <div id="categoryNameError" class="text-red-500 text-xs mt-1 hidden"></div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Description</label>
                        <textarea id="description" rows="3"
                                  class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                  placeholder="Describe this category..."></textarea>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex justify-end space-x-4 mt-6">
                    <button type="button" id="cancelAddModal"
                            class="text-gray-500 border border-gray-300 px-4 py-2 rounded-md hover:bg-gray-100">
                        Cancel
                    </button>
                    <button type="submit" id="submitAddButton"
                            class="bg-teal-600 text-white px-4 py-2 rounded-md hover:bg-teal-700 disabled:opacity-50">
                        Add Category
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Edit Category -->
    <div id="editCategoryModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-2xl p-8 max-h-screen overflow-y-auto">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-gray-700">Edit Category</h2>
                <button id="closeEditModal" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>

            <form id="editCategoryForm" class="space-y-4">
                <input type="hidden" id="editCategoryId">

                <!-- Image Upload -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Category Image</label>
                    <div id="editImagePreview"
                         class="flex items-center justify-center w-full h-32 border-2 border-dashed border-gray-300 rounded-lg text-gray-400 bg-gray-50">
                        <div class="text-center">
                            <p id="defaultEditText">Upload an image or update current image</p>
                        </div>
                        <img id="editedUploadedImage" class="hidden w-full h-full object-cover rounded-lg" />
                    </div>
                    <input type="file" id="editUploadImage" accept="image/*"
                           class="mt-3 w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-teal-50 file:text-teal-700 hover:file:bg-teal-100">
                </div>

                <!-- Category Name & Description -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Category Name <span class="text-red-500">*</span></label>
                        <input id="editCategoryName" type="text"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                               placeholder="e.g., Server Equipment"
                               required />
                        <div id="editCategoryNameError" class="text-red-500 text-xs mt-1 hidden"></div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Description</label>
                        <textarea id="editCategoryDescription" rows="3"
                                  class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                  placeholder="Describe this category..."></textarea>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="flex justify-end space-x-4 mt-6">
                    <button type="button" id="cancelEditModal"
                            class="px-4 py-2 border border-gray-300 rounded-md text-gray-500 hover:bg-gray-100">
                        Cancel
                    </button>
                    <button type="submit" id="submitEditButton"
                            class="text-white px-4 py-2 rounded-md hover:bg-teal-700 bg-teal-600 disabled:opacity-50">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Delete Category -->
    <div id="deleteCategoryModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-md p-8">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-gray-700">Delete Category</h2>
                <button id="closeDeleteModal" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>

            <div class="text-center mb-6">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
                    <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">Delete Category</h3>
                <p class="text-sm text-gray-500">
                    Are you sure you want to delete <span id="deleteCategoryName" class="font-semibold"></span>?
                    This action cannot be undone and will affect <span id="deleteProductCount" class="font-semibold">0</span> products.
                </p>
            </div>

            <div class="flex justify-center space-x-4">
                <button id="cancelDelete" type="button"
                        class="px-4 py-2 border border-gray-300 rounded-md text-gray-500 hover:bg-gray-100">
                    Cancel
                </button>
                <button id="confirmDelete" type="button"
                        class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 disabled:opacity-50">
                    Delete Category
                </button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const API_URL = "/api/Category";
            let categoriesData = [];
            let selectedCategoryId = null;

            // ========================
            // INITIALIZE PAGE
            // ========================
            loadCategories();
            initializeModals();
            initializeImageHandlers();

            // ========================
            // LOAD CATEGORIES
            // ========================
            async function loadCategories() {
                try {
                    showLoading(true);
                    const response = await fetch(API_URL);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    categoriesData = await response.json();
                    renderCategories(categoriesData);
                    updateStats(categoriesData);
                    showLoading(false);
                } catch (error) {
                    console.error("Error loading categories:", error);
                    showError("Failed to load categories. Please refresh the page.");
                    showLoading(false);
                }
            }

            // ========================
            // RENDER CATEGORIES
            // ========================
            function renderCategories(categories) {
                const container = document.getElementById("categoriesGrid");
                if (!categories || categories.length === 0) {
                    container.innerHTML = "";
                    document.getElementById("emptyState").classList.remove("hidden");
                    return;
                }

                document.getElementById("emptyState").classList.add("hidden");
                container.innerHTML = categories.map(category => {
                    // ✅ Use actual image or fallback to dummy
                    const imageUrl = category.image
                        ? `/${category.image}`
                        : '/images/dummy_picture.png';

                    return `
                        <div class="bg-white shadow-md rounded-lg overflow-hidden hover:shadow-lg transition-shadow">
                            <div class="aspect-w-16 aspect-h-9 bg-gray-200">
                                <img src="${imageUrl}"
                                     alt="${category.categoryName}"
                                     class="w-full h-32 object-cover"
                                     onerror="this.src='/images/dummy_picture.png'">
                            </div>
                            <div class="p-4">
                                <div class="flex justify-between items-start mb-2">
                                    <span class="bg-green-100 text-green-600 px-2 py-1 rounded-full text-xs">
                                        ${category.totalItems || 0} products
                                    </span>
                                </div>
                                <h3 class="text-lg font-bold text-gray-700 mb-2">${category.categoryName}</h3>
                                <p class="text-sm text-gray-500 mb-4 line-clamp-2">
                                    ${category.description || "No description available"}
                                </p>
                                <div class="flex justify-between">
                                    <button class="editCategoryButton text-blue-600 hover:text-blue-800 font-medium text-sm"
                                            data-id="${category.id}">
                                        Edit
                                    </button>
                                    <button class="deleteCategoryButton text-red-600 hover:text-red-800 font-medium text-sm"
                                            data-id="${category.id}">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                }).join("");

                // Bind event listeners
                bindCategoryEvents();
            }

            // ========================
            // UPDATE STATS
            // ========================
            function updateStats(categories) {
                const totalCategories = categories.length;
                const totalProducts = categories.reduce((sum, cat) => sum + (cat.totalItems || 0), 0);
                const averageItems = totalCategories > 0 ? Math.round(totalProducts / totalCategories) : 0;

                document.getElementById("totalCategories").textContent = totalCategories;
                document.getElementById("activeCategories").textContent = totalCategories;
                document.getElementById("totalProducts").textContent = totalProducts;
                document.getElementById("averageItems").textContent = averageItems;
            }

            // ========================
            // BIND CATEGORY EVENTS
            // ========================
            function bindCategoryEvents() {
                // Edit buttons
                document.querySelectorAll(".editCategoryButton").forEach(button => {
                    button.addEventListener("click", function() {
                        selectedCategoryId = this.getAttribute("data-id");
                        openEditModal(selectedCategoryId);
                    });
                });

                // Delete buttons
                document.querySelectorAll(".deleteCategoryButton").forEach(button => {
                    button.addEventListener("click", function() {
                        selectedCategoryId = this.getAttribute("data-id");
                        openDeleteModal(selectedCategoryId);
                    });
                });
            }

            // ========================
            // MODAL INITIALIZATION
            // ========================
            function initializeModals() {
                // Add Category Modal
                document.getElementById("addCategoryButton").addEventListener("click", () => {
                    document.getElementById("addCategoryModal").classList.remove("hidden");
                });

                // Close modals
                ["closeAddModal", "cancelAddModal"].forEach(id => {
                    document.getElementById(id).addEventListener("click", () => {
                        document.getElementById("addCategoryModal").classList.add("hidden");
                        resetAddForm();
                    });
                });

                ["closeEditModal", "cancelEditModal"].forEach(id => {
                    document.getElementById(id).addEventListener("click", () => {
                        document.getElementById("editCategoryModal").classList.add("hidden");
                        resetEditForm();
                    });
                });

                ["closeDeleteModal", "cancelDelete"].forEach(id => {
                    document.getElementById(id).addEventListener("click", () => {
                        document.getElementById("deleteCategoryModal").classList.add("hidden");
                    });
                });

                // Form submissions
                document.getElementById("addCategoryForm").addEventListener("submit", handleAddCategory);
                document.getElementById("editCategoryForm").addEventListener("submit", handleEditCategory);
                document.getElementById("confirmDelete").addEventListener("click", handleDeleteCategory);
            }

            // ========================
            // IMAGE HANDLERS
            // ========================
            function initializeImageHandlers() {
                // Add modal image handler
                const uploadInput = document.getElementById("uploadImage");
                const imagePreview = document.getElementById("uploadedImage");
                const defaultText = document.getElementById("defaultText");

                uploadInput.addEventListener("change", function() {
                    handleImagePreview(this, imagePreview, defaultText);
                });

                // Edit modal image handler
                const editUploadInput = document.getElementById("editUploadImage");
                const editImagePreview = document.getElementById("editedUploadedImage");
                const editDefaultText = document.getElementById("defaultEditText");

                editUploadInput.addEventListener("change", function() {
                    handleImagePreview(this, editImagePreview, editDefaultText);
                });
            }

            function handleImagePreview(input, imgElement, textElement) {
                const file = input.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        imgElement.src = e.target.result;
                        imgElement.classList.remove("hidden");
                        textElement.classList.add("hidden");
                    };
                    reader.readAsDataURL(file);
                } else {
                    imgElement.classList.add("hidden");
                    textElement.classList.remove("hidden");
                    imgElement.src = "";
                }
            }

            // ========================
            // ADD CATEGORY
            // ========================
            async function handleAddCategory(e) {
                e.preventDefault();
                const submitButton = document.getElementById("submitAddButton");
                const originalText = submitButton.textContent;

                try {
                    submitButton.disabled = true;
                    submitButton.textContent = "Creating...";

                    // ✅ Create FormData for file upload
                    const formData = new FormData();
                    formData.append('categoryName', document.getElementById("categoryName").value.trim());
                    formData.append('description', document.getElementById("description").value.trim());

                    const imageFile = document.getElementById("uploadImage").files[0];
                    if (imageFile) {
                        formData.append('image', imageFile);
                    }

                    if (!formData.get('categoryName')) {
                        showFieldError("categoryNameError", "Category name is required");
                        return;
                    }

                    const response = await fetch(API_URL, {
                        method: "POST",
                        body: formData // ✅ Send FormData instead of JSON
                    });

                    if (!response.ok) {
                        const errorData = await response.text();
                        throw new Error(errorData || "Failed to create category");
                    }

                    showSuccess("Category created successfully!");
                    document.getElementById("addCategoryModal").classList.add("hidden");
                    resetAddForm();
                    loadCategories(); // Refresh the list
                } catch (error) {
                    console.error("Error creating category:", error);
                    showError("Failed to create category. Please try again.");
                } finally {
                    submitButton.disabled = false;
                    submitButton.textContent = originalText;
                }
            }

            // ========================
            // EDIT CATEGORY
            // ========================
            async function openEditModal(categoryId) {
                try {
                    const response = await fetch(`${API_URL}/${categoryId}`);
                    if (!response.ok) {
                        throw new Error("Failed to fetch category details");
                    }

                    const category = await response.json();
                    document.getElementById("editCategoryId").value = category.id;
                    document.getElementById("editCategoryName").value = category.categoryName || "";
                    document.getElementById("editCategoryDescription").value = category.description || "";

                    // ✅ Show current image if exists
                    const editImagePreview = document.getElementById("editedUploadedImage");
                    const editDefaultText = document.getElementById("defaultEditText");

                    if (category.image) {
                        editImagePreview.src = `/${category.image}`;
                        editImagePreview.classList.remove("hidden");
                        editDefaultText.classList.add("hidden");
                    } else {
                        editImagePreview.classList.add("hidden");
                        editDefaultText.classList.remove("hidden");
                    }

                    document.getElementById("editCategoryModal").classList.remove("hidden");
                } catch (error) {
                    console.error("Error loading category for edit:", error);
                    showError("Failed to load category details.");
                }
            }

            async function handleEditCategory(e) {
                e.preventDefault();
                const submitButton = document.getElementById("submitEditButton");
                const originalText = submitButton.textContent;

                try {
                    submitButton.disabled = true;
                    submitButton.textContent = "Saving...";

                    // ✅ Create FormData for file upload
                    const formData = new FormData();
                    formData.append('id', document.getElementById("editCategoryId").value);
                    formData.append('categoryName', document.getElementById("editCategoryName").value.trim());
                    formData.append('description', document.getElementById("editCategoryDescription").value.trim());

                    const imageFile = document.getElementById("editUploadImage").files[0];
                    if (imageFile) {
                        formData.append('image', imageFile);
                    }

                    if (!formData.get('categoryName')) {
                        showFieldError("editCategoryNameError", "Category name is required");
                        return;
                    }

                    const response = await fetch(`${API_URL}/${selectedCategoryId}`, {
                        method: "PUT",
                        body: formData // ✅ Send FormData instead of JSON
                    });

                    if (!response.ok) {
                        throw new Error("Failed to update category");
                    }

                    showSuccess("Category updated successfully!");
                    document.getElementById("editCategoryModal").classList.add("hidden");
                    resetEditForm();
                    loadCategories(); // Refresh the list
                } catch (error) {
                    console.error("Error updating category:", error);
                    showError("Failed to update category. Please try again.");
                } finally {
                    submitButton.disabled = false;
                    submitButton.textContent = originalText;
                }
            }

            // ========================
            // DELETE CATEGORY
            // ========================
            function openDeleteModal(categoryId) {
                const category = categoriesData.find(cat => cat.id == categoryId);
                if (category) {
                    document.getElementById("deleteCategoryName").textContent = category.categoryName;
                    document.getElementById("deleteProductCount").textContent = category.totalItems || 0;
                    document.getElementById("deleteCategoryModal").classList.remove("hidden");
                }
            }

            async function handleDeleteCategory() {
                const confirmButton = document.getElementById("confirmDelete");
                const originalText = confirmButton.textContent;

                try {
                    confirmButton.disabled = true;
                    confirmButton.textContent = "Deleting...";

                    const response = await fetch(`${API_URL}/${selectedCategoryId}`, {
                        method: "DELETE"
                    });

                    if (!response.ok) {
                        throw new Error("Failed to delete category");
                    }

                    showSuccess("Category deleted successfully!");
                    document.getElementById("deleteCategoryModal").classList.add("hidden");
                    loadCategories(); // Refresh the list
                } catch (error) {
                    console.error("Error deleting category:", error);
                    showError("Failed to delete category. Please try again.");
                } finally {
                    confirmButton.disabled = false;
                    confirmButton.textContent = originalText;
                }
            }

            // ========================
            // UTILITY FUNCTIONS
            // ========================
            function showLoading(show) {
                document.getElementById("loadingState").classList.toggle("hidden", !show);
                document.getElementById("categoriesGrid").classList.toggle("hidden", show);
            }

            function showError(message) {
                const toast = createToast(message, 'error');
                document.body.appendChild(toast);
            }

            function showSuccess(message) {
                const toast = createToast(message, 'success');
                document.body.appendChild(toast);
            }

            function createToast(message, type) {
                const toast = document.createElement('div');
                toast.className = `fixed top-4 right-4 p-4 rounded-md shadow-lg z-50 ${
                    type === 'success' ? 'bg-green-500' : 'bg-red-500'
                } text-white`;
                toast.textContent = message;
                setTimeout(() => {
                    toast.remove();
                }, 3000);
                return toast;
            }

            function showFieldError(fieldId, message) {
                const errorElement = document.getElementById(fieldId);
                errorElement.textContent = message;
                errorElement.classList.remove("hidden");
                setTimeout(() => {
                    errorElement.classList.add("hidden");
                }, 3000);
            }

            function resetAddForm() {
                document.getElementById("addCategoryForm").reset();
                document.getElementById("uploadedImage").classList.add("hidden");
                document.getElementById("defaultText").classList.remove("hidden");
            }

            function resetEditForm() {
                document.getElementById("editCategoryForm").reset();
                document.getElementById("editedUploadedImage").classList.add("hidden");
                document.getElementById("defaultEditText").classList.remove("hidden");
            }
        });
    </script>
</body>
</html>