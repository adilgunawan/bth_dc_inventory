@{
    ViewData["Title"] = "Category ";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen font-sans">
    <div class="container mx-auto p-6">
        <!-- Header -->
        <div class="items-center justify-center">
            <header class="mb-6">
                <h1 class="text-3xl font-bold text-gray-700">Category Management</h1>
                <p class="text-gray-400 text-sm">Manage product categories and classifications</p>
            </header>
            <!-- Add Category Button -->
            <button id="addCategoryButton"
                    class="hover:bg-teal-700  bg-teal-600 text-white px-4 py-2 rounded-md shadow  float-right">
                + Add Category
            </button>
        </div>
 

        <!-- Stats -->
        <section id="categoriesGrid" class="grid grid-cols-1 sm:grid-cols-4 gap-6 mb-6">
            <div class="bg-white shadow-md rounded-lg p-6">
                <p class="text-sm text-gray-400">Total Categories</p>
                <p class="text-3xl font-bold text-purple-600">6</p>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6">
                <p class="text-sm text-gray-400">Active Categories</p>
                <p class="text-3xl font-bold text-green-600">6</p>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6">
                <p class="text-sm text-gray-400">Inactive</p>
                <p class="text-3xl font-bold text-gray-500">0</p>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6">
                <p class="text-sm text-gray-400">Total Products</p>
                <p class="text-3xl font-bold text-blue-600">303</p>
            </div>

        </section>


    </div>

    <!-- Modal Edit -->
    <div id="editCategoryModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-2xl p-8">
            <!-- Header -->
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-gray-700">Edit Category</h2>
                <button id="closeEditModal" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            <!-- Form -->
            <form id="editCategoryForm" class="space-y-4">
                <!-- Image Upload -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Category Image</label>
                    <!-- Image Preview -->
                    <div id="editImagePreview"
                         class="flex items-center justify-center w-full h-32 border-2 border-dashed rounded-lg text-gray-400 bg-gray-50">
                        <span id="defaultEditText">Upload an image or update current image</span>
                        <img id="editedUploadedImage" class="hidden w-full h-full object-cover rounded-lg" />
                    </div>
                    <input type="file" id="editUploadImage" accept="image/*"
                           class="mt-3 w-full text-sm file:bg-teal-600 file:border-0 file:px-4 file:py-2 file:rounded-md file:text-white focus:outline-none">
                </div>
                <!-- Category Name -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">Category Name</label>
                    <input id="editCategoryName" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" placeholder="e.g., Server Equipment">
                </div>
                <!-- Description -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">Description</label>
                    <textarea id="editCategoryDescription" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" placeholder="Describe this category..."></textarea>
                </div>
                <!-- Status Toggle -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">Status</label>
                    <div class="flex items-center space-x-4">
                        <label><input type="radio" name="status" value="active" class="mr-2"> Active</label>
                        <label><input type="radio" name="status" value="inactive" class="mr-2"> Inactive</label>
                    </div>
                </div>
                <!-- Buttons -->
                <div class="flex justify-end space-x-4">
                    <button type="button" id="cancelEditModal" class="px-4 py-2 border border-gray-300 rounded-md text-gray-500 hover:bg-gray-100">
                        Cancel
                    </button>
                    <button type="submit" class=" text-white px-4 py-2 rounded-md hover:bg-teal-700  bg-teal-600">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- Modal Delete -->
    <div id="deleteCategoryModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-md p-8">
            <!-- Header -->
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-gray-700">Delete Category</h2>
                <button id="closeDeleteModal" class="text-gray-500 hover:text-gray-700">&times;</button>
            </div>
            <!-- Message -->
            <p class="text-sm text-gray-500 mb-6">
                Are you sure you want to delete this category? This action cannot be undone.
            </p>
            <!-- Buttons -->
            <div class="flex justify-end space-x-4">
                <button id="cancelDelete" type="button" class="px-4 py-2 border border-gray-300 rounded-md text-gray-500 hover:bg-gray-100">
                    Cancel
                </button>
                <button id="confirmDelete" type="button" class="px-4 py-2 bg-red-500 text-white rounded-md hover:bg-red-600">
                    Delete
                </button>
            </div>
        </div>
    </div>

    <!-- Modal Add Category -->
    <div id="addCategoryModal"
         class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-2xl p-8">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-gray-700">Add New Category</h2>
                <button id="closeModalButton" class="text-gray-500 hover:text-gray-700">&times;</button>
            </div>
            <form id="addCategoryForm" class="space-y-4">

                <!-- Image Upload -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Category Image</label>
                    <div id="imagePreview"
                         class="flex items-center justify-center w-full h-32 border-2 border-dashed rounded-lg text-gray-400 bg-gray-50">
                        <span id="defaultText">Upload an image or select a file</span>
                        <img id="uploadedImage" class="hidden w-full h-full object-cover rounded-lg" />
                    </div>
                    <input type="file"
                           id="uploadImage"
                           accept="image/*"
                           class="mt-3 w-full text-sm file:bg-teal-100 file:border-0 file:px-4 file:py-2 file:rounded-md focus:outline-none" />
                </div>

                <!-- Category Name & Description -->
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">Category Name</label>
                        <input id="categoryName"
                               type="text"
                               class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm"
                               placeholder="e.g., Server Equipment"
                               required />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700">Description</label>
                        <textarea id="description"
                                  class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm"
                                  placeholder="Describe this category..."></textarea>
                    </div>
                </div>

                <!-- Status -->
                <div>
                    <label class="block text-sm font-medium text-gray-700">Status</label>
                    <select id="status"
                            class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm mt-2">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="flex justify-end space-x-4 mt-6">
                    <button type="button"
                            id="closeModalButton_2"
                            class="text-gray-500 border border-gray-300 px-4 py-2 rounded-md">
                        Cancel
                    </button>

                    <button type="submit"
                            class="bg-teal-600 text-white px-4 py-2 rounded-md hover:bg-teal-700">
                        Add Category
                    </button>
                </div>

            </form>
