    <!-- Modal Add Category -->
    <script>
        // Referensi elemen
        const uploadImageInput = document.getElementById("uploadImage");
        const imagePreview = document.getElementById("imagePreview");
        const uploadedImage = document.getElementById("uploadedImage");
        const defaultText = document.getElementById("defaultText");

        // Saat pengguna memilih file
        uploadImageInput.addEventListener("change", () => {
          const file = uploadImageInput.files[0];

          if (file) {
            const reader = new FileReader();

            // Ketika file berhasil dibaca
            reader.onload = function (event) {
              uploadedImage.setAttribute("src", event.target.result);
              uploadedImage.classList.remove("hidden");
              defaultText.classList.add("hidden");
            };

            // Baca file sebagai URL data
            reader.readAsDataURL(file);
          } else {
            // Kembalikan ke state awal jika tidak ada file
            uploadedImage.classList.add("hidden");
            defaultText.classList.remove("hidden");
            uploadedImage.setAttribute("src", "");
          }
        });
    </script>
    <!-- Modal Add Category -->
    <script>
        // Modal Logic
        const addCategoryButton = document.getElementById("addCategoryButton");
        const addCategoryModal = document.getElementById("addCategoryModal");
        const closeModalButtons = document.querySelectorAll("#closeModalButton, #closeModalButton_2");

        // Show Modal
        addCategoryButton.addEventListener("click", () => {
          addCategoryModal.classList.remove("hidden");
        });

        // Close Modal
        closeModalButtons.forEach((button) => {
          button.addEventListener("click", () => {
            addCategoryModal.classList.add("hidden");
          });
        });
    </script>

    <script>
        // Reference elements
        const editButtons = document.querySelectorAll('.editCategoryButton');
        const deleteButtons = document.querySelectorAll('.deleteCategoryButton');

        const editModal = document.getElementById('editCategoryModal');
        const deleteModal = document.getElementById('deleteCategoryModal');

        const closeEditModal = document.getElementById('closeEditModal');
        const closeDeleteModal = document.getElementById('closeDeleteModal');

        const cancelEditModal = document.getElementById('cancelEditModal');
        const cancelDelete = document.getElementById('cancelDelete');
        const confirmDelete = document.getElementById('confirmDelete');

        // Show Edit Modal
        editButtons.forEach(button => {
            button.addEventListener('click', () => {
                editModal.classList.remove('hidden');
            });
        });

        // Show Delete Modal
        deleteButtons.forEach(button => {
            button.addEventListener('click', () => {
                deleteModal.classList.remove('hidden');
            });
        });

        // Close Edit Modal
        closeEditModal.addEventListener('click', () => {
            editModal.classList.add('hidden');
        });
        cancelEditModal.addEventListener('click', () => {
            editModal.classList.add('hidden');
        });

        // Close Delete Modal
        closeDeleteModal.addEventListener('click', () => {
            deleteModal.classList.add('hidden');
        });
        cancelDelete.addEventListener('click', () => {
            deleteModal.classList.add('hidden');
        });

        // Confirm Deletion (Add specific logic here)
        confirmDelete.addEventListener('click', () => {
            alert('Category has been deleted.');
            deleteModal.classList.add('hidden');
        });
    </script>

    <script>
        // Referensi elemen untuk modal edit
        const editUploadImageInput = document.getElementById("editUploadImage");
        const editImagePreview = document.getElementById("editImagePreview");
        const editedUploadedImage = document.getElementById("editedUploadedImage");
        const defaultEditText = document.getElementById("defaultEditText");

        // Saat pengguna memilih file di modal Edit
        editUploadImageInput.addEventListener("change", () => {
            const file = editUploadImageInput.files[0];

            if (file) {
                const reader = new FileReader();

                // Ketika file berhasil dibaca
                reader.onload = function (event) {
                    editedUploadedImage.setAttribute("src", event.target.result);
                    editedUploadedImage.classList.remove("hidden"); // Tampilkan gambar
                    defaultEditText.classList.add("hidden"); // Sembunyikan placeholder
                };

                // Baca file sebagai URL data
                reader.readAsDataURL(file);
            } else {
                // Reset ke keadaan awal
                editedUploadedImage.classList.add("hidden");
                defaultEditText.classList.remove("hidden");
                editedUploadedImage.setAttribute("src", "");
            }
        });
    </script>
</body>

<!--GET ALL DATA-->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const categoryContainer = document.querySelector(".grid");
        const apiUrl = "https://localhost:7035/api/Category";

        // =========================
        // FETCH DATA
        // =========================
        fetch(apiUrl)
            .then(response => {
                if (!response.ok) {
                    throw new Error("Network error: " + response.statusText);
                }
                return response.json();
            })
            .then(data => {

                categoryContainer.innerHTML = "";

                if (!data || data.length === 0) {
                    categoryContainer.innerHTML = "<p>No categories found.</p>";
                    return;
                }

                data.forEach(category => {

                    const categoryCard = `
                        <div class="bg-white shadow-md rounded-lg overflow-hidden p-4">

                            <img src="${category.imageUrl}"
                                 alt="${category.categoryName}"
                                 class="rounded-lg mb-4">

                            <span class="bg-green-100 text-green-600 px-2 py-1 rounded-full text-xs">
                                ${category.totalItems ?? 0} products
                            </span>

                            <h2 class="text-lg font-bold text-gray-700 mt-2">
                                ${category.categoryName}
                            </h2>

                            <p class="text-sm text-gray-500">
                                ${category.description ?? "-"}
                            </p>

                            <div class="mt-4 flex justify-between text-sm">
                                <button class="text-blue-500 hover:underline editCategoryButton"
                                        data-id="${category.id}">
                                    Edit
                                </button>

                                <button class="text-red-500 hover:underline deleteCategoryButton"
                                        data-id="${category.id}">
                                    Delete
                                </button>
                            </div>
                        </div>
                    `;

                    categoryContainer.insertAdjacentHTML("beforeend", categoryCard);
                });

            })
            .catch(error => {
                console.error("Error fetching categories:", error);
                categoryContainer.innerHTML = "<p class='text-red-500'>Failed to load categories.</p>";
            });


       

    });
</script>

<!--EDIT MODAL-->
<script>
        document.addEventListener("DOMContentLoaded", function () {
        const editModal = document.getElementById("editCategoryModal");
        const deleteModal = document.getElementById("deleteCategoryModal");
        const closeEditModal = document.getElementById("closeEditModal");
        const closeDeleteModal = document.getElementById("closeDeleteModal");
        const confirmDeleteButton = document.getElementById("confirmDelete");
        const apiUrl = "https://localhost:7035/api/Category"; // Sesuaikan dengan URL API Anda

        let selectedCategoryId = null; // Untuk menyimpan ID kategori yang sedang diedit/dihapus

        // Fetch dan render semua kategori
        function fetchCategories() {
            fetch(apiUrl)
                .then((response) => {
                    if (!response.ok) {
                        throw new Error("Failed to fetch categories.");
                    }
                    return response.json();
                })
                .then((categories) => {
                    renderCategoryTable(categories);
                })
                .catch((error) => {
                    console.error("Error fetching categories:", error);
                    alert("Failed to load categories. Please try again.");
                });
        }


        // Render kategori ke dalam HTML
        function renderCategoryTable(categories) {
            const categoryContainer = document.querySelector(".grid");
            categoryContainer.innerHTML = ""; // Kosongkan tabel sebelumnya
            categories.forEach((category) => {
                const categoryCard = `
                    <a href="#" class="p-4 hover: transition">
                        <div class="bg-white shadow-md rounded-lg overflow-hidden p-4">
                            <img src="/images/dummy_picture.png" alt="${category.categoryName}" class="rounded-lg mb-4">
                            <span class="bg-green-100 text-green-600 px-2 py-1 rounded-full text-xs">${category.totalItems} products</span>
                            <h2 class="text-lg font-bold text-gray-700 mt-2">${category.categoryName}</h2>
                            <p class="text-sm text-gray-500">${category.description}</p>
                            <div class="mt-4 flex justify-between text-sm">
                                <button class="text-blue-500 hover:underline editCategoryButton" data-id="${category.id}">
                                    Edit
                                </button>
                                <button class="text-red-500 hover:underline deleteCategoryButton" data-id="${category.id}">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </a>`;
                categoryContainer.insertAdjacentHTML("beforeend", categoryCard);
            });

            // Bind event listeners untuk tombol edit dan delete
            bindEditButtons();
            bindDeleteButtons();
        }

        // Bind tombol edit kategori
        function bindEditButtons() {
            const editButtons = document.querySelectorAll(".editCategoryButton");
            editButtons.forEach((button) => {
                button.addEventListener("click", function () {
                    selectedCategoryId = this.dataset.id; // Tangkap ID kategori
                    openEditModal(selectedCategoryId);
                });
            });
        }

        // Bind tombol delete kategori
        function bindDeleteButtons() {
            const deleteButtons = document.querySelectorAll(".deleteCategoryButton");
            deleteButtons.forEach((button) => {
                button.addEventListener("click", function () {
                    selectedCategoryId = this.dataset.id; // Tangkap ID kategori
                    openDeleteModal();
                });
            });
        }

        // Fungsi untuk membuka modal Edit
        function openEditModal(categoryId) {
            fetch(`${apiUrl}/${categoryId}`)
                .then((response) => {
                    if (!response.ok) {
                        throw new Error("Failed to fetch category details.");
                    }
                    return response.json();
                })
                .then((category) => {
                    // Isi modal edit dengan data kategori
                    document.getElementById("editCategoryName").value = category.categoryName;
                    document.getElementById("editCategoryDescription").value = category.description;
                    editModal.classList.remove("hidden"); // Tampilkan modal edit
                })
                .catch((error) => {
                    console.error("Error fetching category details:", error);
                    alert("Failed to load category details. Please try again.");
                });
        }

        // Handle form submit untuk update kategori
        document.getElementById("editCategoryForm").addEventListener("submit", function (event) {
            event.preventDefault();

            const updatedCategory = {
                id: selectedCategoryId,
                categoryName: document.getElementById("editCategoryName").value,
                description: document.getElementById("editCategoryDescription").value,
            };

            // Kirim permintaan PUT untuk memperbarui kategori
            fetch(`${apiUrl}/${selectedCategoryId}`, {
                method: "PUT",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify(updatedCategory),
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error("Failed to update category.");
                    }
                    return response.json();
                })
                .then(() => {
                    alert("Category successfully updated.");
                    fetchCategories(); // Refresh daftar kategori
                    editModal.classList.add("hidden"); // Tutup modal
                })
                .catch((error) => {
                    console.error("Error updating category:", error);
                    alert("Failed to update category. Please try again.");
                });
        });

        // Fungsi untuk membuka modal Delete
        function openDeleteModal() {
            deleteModal.classList.remove("hidden"); // Tampilkan modal delete
        }

        // Handle konfirmasi penghapusan kategori
        confirmDeleteButton.addEventListener("click", function () {
            fetch(`${apiUrl}/${selectedCategoryId}`, {
                method: "DELETE",
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error("Failed to delete category.");
                    }
                    fetchCategories(); // Refresh daftar kategori
                    deleteModal.classList.add("hidden"); // Tutup modal
                    alert("Category successfully deleted.");
                })
                .catch((error) => {
                    console.error("Error deleting category:", error);
                    alert("Failed to delete category. Please try again.");
                });
        });

        // Close Modals
        [closeEditModal, cancelEditModal].forEach((button) => {
            button.addEventListener("click", () => editModal.classList.add("hidden"));
        });
        [closeDeleteModal, cancelDelete].forEach((button) => {
            button.addEventListener("click", () => deleteModal.classList.add("hidden"));
        });

        // Fetch dan render kategori saat halaman dimuat
        fetchCategories();
    });
</script>

<!--ADD MODAL-->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("addCategoryForm");
        const modal = document.getElementById("addCategoryModal");

        form.addEventListener("submit", async function (e) {
            e.preventDefault();

            const categoryName = document.getElementById("categoryName").value.trim();
            const description = document.getElementById("description").value.trim();

            try {

                const response = await fetch("/api/category", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        categoryName: categoryName,
                        description: description
                    })
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    console.log(errorData);
                    alert("Failed to create category.");
                    return;
                }

                alert("Category created successfully!");

                form.reset();
                modal.classList.add("hidden");

                location.reload(); // optional refresh

            } catch (error) {
                console.error(error);
                alert("Something went wrong.");
            }
        });

    });
</script>

</html>