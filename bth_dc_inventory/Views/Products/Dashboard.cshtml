@{
    ViewData["Title"] = "Dashboard";
}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

    <body class="bg-gray-50 min-h-screen font-sans">

    <div class="container mx-auto p-6">
        <!-- Header -->
        <header class="mb-6 flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-700">Infineon Technologies Batam</h1>
                <p class="text-gray-400 text-sm">Dashboard Data Center Inventory</p>
            </div>
            
            <!-- Search Engine -->
            <div class="flex items-center space-x-3">
                <input type="text" id="searchInput" placeholder="Search..."
                       class="w-64 bg-white border border-gray-300 rounded-md px-4 py-2 text-sm text-gray-600 focus:outline-none focus:ring-2 focus:ring-teal-500 placeholder-gray-400">
                <button id="searchButton"
                        class="bg-teal-600 text-white px-4 py-2 text-sm font-medium rounded-md hover:bg-teal-700 transition">
                    Search
                </button>
            </div>
        </header>

        <!-- Stats Cards -->
        <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
            <!-- Total Products Card -->
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center">
                <div>
                    <h3 class="text-sm text-gray-400">Total Products</h3>
                    <p class="text-3xl font-bold text-teal-600">215</p>
                    <p class="text-sm text-gray-400">Active inventory items</p>
                </div>
                <div class="ml-auto bg-teal-100 text-teal-600 rounded-full p-4">
                    <img src="~/icons/box.svg" alt="Alternate Text" />
                </div>
            </div>

            <!-- Pending Products Card -->
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center">
                <div>
                    <h3 class="text-sm text-gray-400">Products Pending</h3>
                    <p class="text-3xl font-bold text-orange-500">88</p>
                    <p class="text-sm text-gray-400">Status pending</p>
                </div>
                <div class="ml-auto bg-orange-100 text-orange-600 rounded-full p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24"><rect width="24" height="24" fill="none" /><path fill="currentColor" d="M17 22q-2.075 0-3.537-1.463T12 17t1.463-3.537T17 12t3.538 1.463T22 17t-1.463 3.538T17 22m1.675-2.625l.7-.7L17.5 16.8V14h-1v3.2zM5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h4.175q.275-.875 1.075-1.437T12 1q1 0 1.788.563T14.85 3H19q.825 0 1.413.588T21 5v6.25q-.45-.325-.95-.55T19 10.3V5h-2v3H7V5H5v14h5.3q.175.55.4 1.05t.55.95zm7-16q.425 0 .713-.288T13 4t-.288-.712T12 3t-.712.288T11 4t.288.713T12 5" /></svg>
                </div>
            </div>

            <!-- Servers Card -->
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center">
                <div>
                    <h3 class="text-sm text-gray-400">Servers</h3>
                    <p class="text-3xl font-bold text-blue-600">76</p>
                    <p class="text-sm text-gray-400">24.8% of total items</p>
                </div>
                <div class="ml-auto bg-blue-100 text-blue-600 rounded-full p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M4 1h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1m0 8h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1m0 8h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1M9 5h1V3H9zm0 8h1v-2H9zm0 8h1v-2H9zM5 3v2h2V3zm0 8v2h2v-2zm0 8v2h2v-2z" />
                    </svg>
                </div>
            </div>

            <!-- Cable Power Card -->
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center">
                <div>
                    <h3 class="text-sm text-gray-400">Cable Power</h3>
                    <p class="text-3xl font-bold text-purple-600">170</p>
                    <p class="text-sm text-gray-400">55.6% of total items</p>
                </div>
                <div class="ml-auto bg-purple-100 text-purple-600 rounded-full p-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M5 21q-.425 0-.712-.288T4 20v-1H3v-4q0-.425.288-.712T4 14h1V7q0-1.65 1.175-2.825T9 3t2.825 1.175T13 7v10q0 .825.588 1.413T15 19t1.413-.587T17 17v-7h-1q-.425 0-.712-.288T15 9V5h1V4q0-.425.288-.712T17 3h2q.425 0 .713.288T20 4v1h1v4q0 .425-.288.713T20 10h-1v7q0 1.65-1.175 2.825T15 21t-2.825-1.175T11 17V7q0-.825-.587-1.412T9 5t-1.412.588T7 7v7h1q.425 0 .713.288T9 15v4H8v1q0 .425-.288.713T7 21z" />
                    </svg>
                </div>
            </div>
        </section>

        <!-- Inventory Distribution & Quick Overview -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <!-- Inventory Distribution -->
            <!-- Inventory Distribution -->
            <div class="col-span-2 bg-white shadow-md rounded-lg p-6">
                <h3 class="text-lg font-bold text-gray-700 mb-4">Inventory Distribution</h3>
                <p class="text-sm text-gray-400">Breakdown by equipment type</p>
                <!-- Pie Chart -->
                <div class="flex justify-center mt-6">
                    <canvas id="inventoryPieChart" class="w-48 h-48"></canvas>
                </div>
            </div>
          

            <!-- Quick Overview -->
            <div class="bg-white shadow-md rounded-lg p-6">
                <h3 class="text-lg font-bold text-gray-700 mb-4">Quick Overview</h3>
                <div>
                    <p class="text-sm text-gray-400">Total Items</p>
                    <p class="text-lg font-bold text-gray-700">645</p>
                </div>
                <div>
                    <p class="text-sm text-gray-400">Active</p>
                    <p class="text-lg font-bold text-green-600">215</p>
                </div>
                <div>
                    <p class="text-sm text-gray-400">Pending</p>
                    <p class="text-lg font-bold text-red-600">88</p>
                </div>
            </div>
        </section>

        <!-- Data Centers -->
        <section>
            <h3 class="text-lg font-bold text-gray-700 mb-6">Data Centers</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Data Center 1 -->
                <div class="relative bg-gradient-to-br from-blue-500 to-blue-400 text-white p-6 rounded-lg shadow-md">
                    <p class="mb-2 text-sm font-medium opacity-90">Data Center 1</p>
                    <p class="text-sm font-bold opacity-80">Batam 1 BLok 3</p>
                    <div class="mt-4">
                        <h4 class="text-3xl font-bold mb-1">215</h4>
                        <p class="text-sm opacity-80">Active Items</p>
                        <div class="mt-3 flex items-center justify-between">
                            <span class="text-sm opacity-80">Capacity: <strong>300</strong></span>
                            <span class="inline-block bg-white text-xs px-3 py-1 rounded-full text-teal-600">
                                Operational
                            </span>
                        </div>
                        <div class="mt-3 bg-white h-2 rounded-full">
                            <div class="h-2 bg-teal-500 rounded-full" style="width: 71.7%;"></div>
                        </div>
                        <div class="mt-3 flex justify-between text-xs opacity-80">
                            <span>71.7% utilized</span>
                            <span>12.5 TB</span>
                        </div>
                        <button class="mt-4 inline-flex items-center text-sm text-white border border-white rounded-md px-3 py-1 transition hover:bg-white hover:text-blue-400">
                            View Details →
                        </button>
                    </div>
                </div>

                <!-- Data Center 2 -->
                <div class="relative bg-gradient-to-br from-teal-500 to-teal-400 text-white p-6 rounded-lg shadow-md">
                    <p class="mb-2 text-sm font-medium opacity-90">Data Center 2</p>
                    <p class="text-sm font-bold opacity-80">Batam 1 Blok 2</p>
                    <div class="mt-4">
                        <h4 class="text-3xl font-bold mb-1">215</h4>
                        <p class="text-sm opacity-80">Active Items</p>
                        <div class="mt-3 flex items-center justify-between">
                            <span class="text-sm opacity-80">Capacity: <strong>300</strong></span>
                            <span class="inline-block bg-white text-xs px-3 py-1 rounded-full text-teal-600">
                                Operational
                            </span>
                        </div>
                        <div class="mt-3 bg-white h-2 rounded-full">
                            <div class="h-2 bg-teal-500 rounded-full" style="width: 77%;"></div>
                        </div>
                        <div class="mt-3 flex justify-between text-xs opacity-80">
                            <span>77% utilized</span>
                            <span>18.7 TB</span>
                        </div>
                        <button class="mt-4 inline-flex items-center text-sm text-white border border-white rounded-md px-3 py-1 transition hover:bg-white hover:text-teal-400">
                            View Details →
                        </button>
                    </div>
                </div>

                <!-- Data Center 3 -->
                <div class="relative bg-gradient-to-br from-purple-500 to-purple-400 text-white p-6 rounded-lg shadow-md">
                    <p class="mb-2 text-sm font-medium opacity-90">Data Center 3</p>
                    <p class="text-sm font-bold opacity-80">Batam 3</p>
                    <div class="mt-4">
                        <h4 class="text-3xl font-bold mb-1">215</h4>
                        <p class="text-sm opacity-80">Active Items</p>
                        <div class="mt-3 flex items-center justify-between">
                            <span class="text-sm opacity-80">Capacity: <strong>300</strong></span>
                            <span class="inline-block bg-white text-xs px-3 py-1 rounded-full text-purple-600">
                                Operational
                            </span>
                        </div>
                        <div class="mt-3 bg-white h-2 rounded-full">
                            <div class="h-2 bg-purple-500 rounded-full" style="width: 71.7%;"></div>
                        </div>
                        <div class="mt-3 flex justify-between text-xs opacity-80">
                            <span>71.7% utilized</span>
                            <span>15.2 TB</span>
                        </div>
                        <button class="mt-4 inline-flex items-center text-sm text-white border border-white rounded-md px-3 py-1 transition hover:bg-white hover:text-purple-400">
                            View Details →
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <script>
        // Data for Pie Chart
        const chartData = {
            labels: ["Server", "PDU", "Switch", "Cable Power", "Rack"],
            datasets: [
                {
                    label: "Inventory Distribution",
                    data: [76, 30, 12, 170, 18], // Example data
                    backgroundColor: [
                        "#22D3EE", // Cyan
                        "#FACC15", // Yellow
                        "#34D399", // Green
                        "#A78BFA", // Purple
                        "#F87171"  // Red
                    ],
                    hoverOffset: 4,
                },
            ],
        };

        // Config for Pie Chart
        const config = {
            type: "pie", // Defines the chart type
            data: chartData,
            options: {
                responsive: true,
                        maintainAspectRatio: false, // Disable the default aspect ratio handling

                plugins: {
                    legend: {
                        position: "right", // Position of legend
                    },
                    tooltip: {
                        callbacks: {
                            label: function (tooltipItem) {
                                const value = chartData.datasets[0].data[tooltipItem.dataIndex];
                                const label = chartData.labels[tooltipItem.dataIndex];
                                const percentage = (
                                    (value /
                                        chartData.datasets[0].data.reduce(
                                            (a, b) => a + b,
                                            0
                                        )) *
                                    100
                                ).toFixed(1);
                                return `${label}: ${value} (${percentage}%)`;
                            },
                        },
                    },
                },
            },
        };

        // Render the chart
        const ctx = document.getElementById("inventoryPieChart").getContext("2d");
        new Chart(ctx, config);
    </script>
</body>

</html>



