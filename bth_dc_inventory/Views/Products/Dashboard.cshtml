@{
    ViewData["Title"] = "Dashboard";
}


<main class="flex-1 p-6">
            <!-- Header -->
            <header class="flex justify-between mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-700">Infineon Technologies Batam</h1>
                    <p class="text-gray-400"> Dashboard Data Center Inventory</p>
                </div>
                
            </header>

            <!-- Stats Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 flex inline-flex">
                <div class="p-4 bg-white rounded-lg shadow-md flex flex-col">
                    <div class="flex items-center justify-between h-auto w-auto">
                        <h3 class="text-gray-500">Total Products</h3>
                        <img src="~/icons/box.svg" class=" ">
                    </div>
                    <p class="text-teal-600 text-2xl font-semibold">215</p>
                    <p class="text-gray-400 text-sm">Active inventory items</p>
                </div>
                <div class="p-4 bg-white rounded-lg shadow-md flex flex-col">
                    <h3 class="text-gray-500">Products Pending</h3>
                    <p class="text-orange-500 text-2xl font-semibold">88</p>
                    <p class="text-gray-400 text-sm">Status Pending</p>
                </div>
            </div>

            <!-- Chart and Data Center Stats -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <!-- Placeholder Chart -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h4 class="text-gray-700 mb-4">Data Center Analysis</h4>
                    <!-- Chart -->
                    <div class="flex-1">
                        <h2 class="text-lg font-semibold text-gray-700 mb-4">Report Summary</h2>
                        <canvas id="reportChart" class="w-full h-48"></canvas>
                    </div>
                </div>

                <!-- Data Center Overview -->
                <div class="grid grid-cols-3 gap-4 flex ">
                    <div class="p-4 bg-white rounded-lg shadow-md">
                        <h3>Data Center 1</h3>
                        <p>215 Active inventory items</p>
                    </div>
                    <div class="p-4 bg-white rounded-lg shadow-md">
                        <h3>Data Center 2</h3>
                        <p>215 Active inventory items</p>
                    </div>
                    <div class="p-4 bg-white rounded-lg shadow-md">
                        <h3>Data Center 3</h3>
                        <p>215 Active inventory items</p>
                    </div>
                </div>
            </div>
            <!-- Chart.js Configuration -->
            <script>
                const ctx = document.getElementById('reportChart').getContext('2d');
                new Chart(ctx, {
                  type: 'pie',
                  data: {
                    labels: ['Server', 'Cable', 'PDU'],
                    datasets: [{
                      data: [55, 25, 20],
                      backgroundColor: ['#4CAF50', '#FF9800', '#03A9F4'],
                    }]
                  }
                });
            </script>
        </main>
