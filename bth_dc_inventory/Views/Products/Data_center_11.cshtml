    <!-- searching features  !-->
    <script>
        // Menjalankan script setelah DOM selesai dimuat
        document.addEventListener("DOMContentLoaded", () => {
            const productTableBody = document.getElementById("productTableBody"); // Body tabel untuk produk
            const paginationDiv = document.getElementById("pagination"); // Div untuk pagination
            const searchInput = document.querySelector("#search"); // Input search elemen
            const pageSize = 10; // Jumlah item per halaman
            let currentPage = 1; // Halaman saat ini
            let totalPages = 0; // Total halaman
            let currentSearchQuery = ""; // Query pencarian saat ini (kosong di awal)

            /**
             * Fungsi untuk memuat produk berdasarkan parameter pencarian dan halaman
             */
            async function fetchProducts(page, searchQuery = "") {
                const loader = document.getElementById("loader"); // Loader (opsional jika diimplementasikan)

                // Tampilkan loader jika ada
                if (loader) loader.classList.remove("hidden");

                try {
                    // URL API dengan parameter pencarian dan pagination
                    const response = await fetch(
                        `/api/items/filter?search=${searchQuery}&page=${page}&pageSize=${pageSize}`,
                        {
                            method: "GET",
                            headers: {
                                "Content-Type": "application/json"
                            }
                        }
                    );

                    if (!response.ok) {
                        throw new Error(`Failed to fetch products. Status: ${response.status}`);
                    }

                    const data = await response.json();

                    // Perbarui table dan elemen pagination
                    updateTable(data.data); // Tampilkan produk
                    updatePagination(data.page, data.totalPages); // Tampilkan paginasi

                } catch (error) {
                    console.error("Error fetching products:", error);
                    alert("Failed to fetch products. Please try again.");
                } finally {
                    // Sembunyikan loader jika ada
                    if (loader) loader.classList.add("hidden");
                }
            }

            /**
             * Fungsi untuk memperbarui tabel produk berdasarkan data yang diterima
             */
            function updateTable(products) {
                // Kosongkan tabel sebelum menambahkan data
                productTableBody.innerHTML = "";

                // Jika tidak ada data, tampilkan pesan
                if (products.length === 0) {
                    productTableBody.innerHTML = `
                        <tr>
                            <td colspan="7" class="text-center py-3">No products found</td>
                        </tr>`;
                    return;
                }

                // Tambahkan data produk ke tabel
                products.forEach(product => {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td class="px-4 py-3">${product.itemCode || "-"}</td>
                        <td class="px-4 py-3">${product.itemName || "-"}</td>
                        <td class="px-4 py-3">${product.assetNumber || "-"}</td>
                        <td class="px-4 py-3">
                            <span class="bg-gray-200 px-3 py-1 rounded-full text-xs">${product.categoryName}</span>
                        </td>
                        <td class="px-4 py-3">${product.dataCenterName || "-"}</td>
                        <td class="px-4 py-3">
                            <a href="/Products/Detail?id=${product.id}"
                               class="text-teal-600 bg-teal-50 px-3 py-1 rounded-full text-xs hover:bg-teal-700 hover:text-white">
                               Detail Product
                            </a>
                        </td>
                        <td class="px-4 py-3 flex gap-2">
                            <button class="editProductButton border p-2 rounded hover:bg-gray-100">✏️</button>
                            <button class="deleteProductButton border p-2 rounded text-red-500 hover:bg-red-50">🗑️</button>
                        </td>
                    `;
                    productTableBody.appendChild(row);
                });
            }

            /**
             * Fungsi untuk memperbarui elemen pagination
             */
            function updatePagination(page, totalPagesCount) {
                currentPage = page; // Perbarui halaman saat ini
                totalPages = totalPagesCount; // Perbarui jumlah halaman total

                // Kosongkan elemen pagination sebelumnya
                paginationDiv.innerHTML = "";

                // Jika hanya ada 1 halaman, sembunyikan pagination
                if (totalPages <= 1) return;

                // Tombol halaman sebelumnya
                if (currentPage > 1) {
                    paginationDiv.innerHTML += `
                        <button
                            data-page="${currentPage - 1}"
                            class="pagination-button px-3 py-1 bg-teal-600 text-white rounded">
                            Previous
                        </button>`;
                }

                // Tombol untuk setiap halaman
                for (let i = 1; i <= totalPages; i++) {
                    const activeClass = i === currentPage ? "bg-teal-600 text-white" : "bg-gray-300 text-black";
                    paginationDiv.innerHTML += `
                        <button
                            data-page="${i}"
                            class="pagination-button px-3 py-1 rounded ${activeClass}">
                            ${i}
                        </button>`;
                }

                // Tombol halaman berikutnya
                if (currentPage < totalPages) {
                    paginationDiv.innerHTML += `
                        <button
                            data-page="${currentPage + 1}"
                            class="pagination-button px-3 py-1 bg-teal-600 text-white rounded">
                            Next
                        </button>`;
                }

                // Tambahkan event listener untuk setiap tombol pagination
                document.querySelectorAll(".pagination-button").forEach(button => {
                    button.addEventListener("click", function () {
                        const selectedPage = parseInt(this.getAttribute("data-page"));
                        fetchProducts(selectedPage, currentSearchQuery); // Muat data dengan pencarian saat ini
                    });
                });
            }

            /**
             * Event untuk Search Bar (trigger pada tombol Enter)
             */
            searchInput.addEventListener("keypress", function (event) {
                if (event.key === "Enter") { // Deteksi tombol Enter
                    currentSearchQuery = event.target.value.trim(); // Simpan query pencarian
                    fetchProducts(1, currentSearchQuery); // Muat data dari halaman pertama dengan pencarian
                }
            });

            /**
             * Inisialisasi halaman pertama
             */
            fetchProducts(1); // Memuat data tanpa filter pada awal halaman
        });
    </script>   


</html>