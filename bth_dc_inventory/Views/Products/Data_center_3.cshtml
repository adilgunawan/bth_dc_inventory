@{
    ViewData["Title"] = "Data Center 3";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between my-8">
            <div>
                <h1 class="text-2xl font-semibold">Data Center 3</h1>
                <p class="text-gray-500">Manage Data Center Products</p>
            </div>
            <button id="openModal" class="flex items-center gap-2 bg-teal-600 text-white px-4 py-2 rounded-lg hover:bg-teal-700">
                <span class="text-xl">+</span>
                Add Product
            </button>
        </div>

        <!-- Add Product Modal -->
        <div id="addProductModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
            <div class="bg-white max-w-lg w-full mx-auto rounded-lg p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-700 mb-4">New Product</h2>
                <form id="addProductForm" class="space-y-4">
                    <!-- Product Name -->
                    <div>
                        <label for="productName" class="text-sm font-medium text-gray-700">Product Name</label>
                        <input type="text" id="productName" placeholder="Enter product name"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Product ID -->
                    <div>
                        <label for="productId" class="text-sm font-medium text-gray-700">Product ID</label>
                        <input type="text" id="productId" placeholder="Enter product ID"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Category -->
                    <div>
                        <label for="category" class="text-sm font-medium text-gray-700">Category</label>
                        <select id="category"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                required>
                            <option value="">Select product category</option>
                        </select>
                    </div>

                    <!-- Buying Price -->
                    <div>
                        <label for="buyingPrice" class="text-sm font-medium text-gray-700">Buying Price $</label>
                        <input type="number" id="buyingPrice" placeholder="Enter buying price"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Quantity -->
                    <div>
                        <label for="quantity" class="text-sm font-medium text-gray-700">Quantity</label>
                        <input type="number" id="quantity" placeholder="Enter product quantity"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Location -->
                    <div>
                        <label for="location" class="text-sm font-medium text-gray-700">Location</label>
                        <select id="location"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                required>
                            <option value="">Select Location</option>
                        </select>
                    </div>

                    <!-- Date of Purchase -->
                    <div>
                        <label for="dateOfPurchase" class="text-sm font-medium text-gray-700">Date of Purchase</label>
                        <input type="date" id="dateOfPurchase"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Status -->
                    <div>
                        <label for="status" class="text-sm font-medium text-gray-700">Status</label>
                        <select id="status"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                required>
                            <option value="">Select Status Product</option>
                            <option value="Pending">Pending</option>
                            <option value="Arrived">Arrived</option>
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="flex justify-end space-x-4">
                        <button type="button" id="closeModal" class="px-4 py-2 text-sm text-gray-500 border border-gray-300 rounded-md hover:bg-gray-100">Discard</button>
                        <button type="submit" class="px-4 py-2 text-sm bg-teal-600 text-white rounded-md hover:bg-teal-700">Add Product</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Edit Product Modal -->
        <div id="editProductModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
            <div class="bg-white max-w-lg w-full mx-auto rounded-lg p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-700 mb-4">Edit Product</h2>
                <form id="editProductForm" class="space-y-4">
                    <input type="hidden" id="editItemId">

                    <!-- Product Name -->
                    <div>
                        <label for="editProductName" class="text-sm font-medium text-gray-700">Product Name</label>
                        <input type="text" id="editProductName" placeholder="Enter product name"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Product ID -->
                    <div>
                        <label for="editProductId" class="text-sm font-medium text-gray-700">Product ID</label>
                        <input type="text" id="editProductId" placeholder="Enter product ID"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Category -->
                    <div>
                        <label for="editCategory" class="text-sm font-medium text-gray-700">Category</label>
                        <select id="editCategory"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                required>
                            <option value="">Select product category</option>
                        </select>
                    </div>

                    <!-- Buying Price -->
                    <div>
                        <label for="editBuyingPrice" class="text-sm font-medium text-gray-700">Buying Price $</label>
                        <input type="number" id="editBuyingPrice" placeholder="Enter buying price"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Quantity -->
                    <div>
                        <label for="editQuantity" class="text-sm font-medium text-gray-700">Quantity</label>
                        <input type="number" id="editQuantity" placeholder="Enter product quantity"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Location -->
                    <div>
                        <label for="editLocation" class="text-sm font-medium text-gray-700">Location</label>
                        <select id="editLocation"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                required>
                            <option value="">Select Location</option>
                        </select>
                    </div>

                    <!-- Date of Purchase -->
                    <div>
                        <label for="editDateOfPurchase" class="text-sm font-medium text-gray-700">Date of Purchase</label>
                        <input type="date" id="editDateOfPurchase"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Status -->
                    <div>
                        <label for="editStatus" class="text-sm font-medium text-gray-700">Status</label>
                        <select id="editStatus"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                required>
                            <option value="">Select Status Product</option>
                            <option value="Pending">Pending</option>
                            <option value="Arrived">Arrived</option>
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="flex justify-end space-x-4">
                        <button type="button" id="closeEditModal" class="px-4 py-2 text-sm text-gray-500 border border-gray-300 rounded-md hover:bg-gray-100">Cancel</button>
                        <button type="submit" class="px-4 py-2 text-sm bg-teal-600 text-white rounded-md hover:bg-teal-700">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Delete Modal -->
        <div id="deleteModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
            <div class="bg-white w-96 rounded-lg p-6 shadow-lg">
                <h2 class="text-lg font-semibold text-gray-700 text-center mb-4">Delete Product</h2>
                <p class="text-sm text-gray-500 text-center mb-6">
                    Are you sure you want to delete
                    <span id="deleteProductName" class="font-medium text-gray-800"></span>?
                    This action cannot be undone.
                </p>
                <div class="flex justify-center space-x-4">
                    <button type="button" id="closeDeleteModal"
                            class="px-4 py-2 text-sm text-gray-500 border border-gray-300 rounded-lg hover:bg-gray-100">
                        Cancel
                    </button>
                    <button type="button" id="confirmDeleteButton"
                            class="px-4 py-2 text-sm bg-red-600 text-white rounded-lg hover:bg-red-700">
                        Yes
                    </button>
                </div>
            </div>
        </div>

        <!-- Search & Filter -->
        <div class="bg-white p-4 rounded-xl shadow-sm flex items-center m-1 mb-10">
            <div class="flex items-center bg-gray-100 rounded-lg px-3 py-2 flex-1 me-4">
                <input type="text" id="search" placeholder="Search products..."
                       class="bg-transparent outline-none flex-1 text-sm" />
            </div>
            <select id="categoryFilter" class="bg-gray-100 px-4 py-2 rounded-lg text-sm outline-none">
                <option value="">All Categories</option>
            </select>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="text-left px-4 py-3">PO Number</th>
                        <th class="text-left px-4 py-3">Product Name</th>
                        <th class="text-left px-4 py-3">Asset Number</th>
                        <th class="text-left px-4 py-3">Category</th>
                        <th class="text-left px-4 py-3">Location</th>
                        <th class="text-left px-4 py-3">Detail Product</th>
                        <th class="text-left px-4 py-3">Action</th>
                    </tr>
                </thead>
                <tbody id="productTableBody" class="divide-y">
                    <!-- Dynamic content will be loaded here -->
                </tbody>
            </table>

            <!-- Pagination -->
            <div id="pagination" class="flex justify-center gap-2 mt-4 p-4"></div>
        </div>

        <div id="loader" class="hidden text-center py-4">🔄 Loading...</div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const DATA_CENTER_ID = 6; // Data Center 3 ID
            const productTableBody = document.getElementById("productTableBody");
            const paginationDiv = document.getElementById("pagination");
            const searchInput = document.querySelector("#search");
            const categoryFilter = document.getElementById("categoryFilter");
            const pageSize = 10;
            let currentPage = 1;
            let totalPages = 0;
            let currentSearchQuery = "";
            let currentCategoryFilter = "";

            // ========================
            // LOAD INITIAL DATA
            // ========================
            loadDataCenter3Products();
            loadCategoryFilter();
            loadDropdowns();

            // ========================
            // ADD PRODUCT MODAL
            // ========================
            const addProductForm = document.getElementById("addProductForm");
            const openModal = document.getElementById("openModal");
            const closeModal = document.getElementById("closeModal");
            const addProductModal = document.getElementById("addProductModal");

            openModal.addEventListener("click", () => {
                addProductModal.classList.remove("hidden");
            });

            closeModal.addEventListener("click", () => {
                addProductModal.classList.add("hidden");
                addProductForm.reset();
            });

            // Close modal on background click
            addProductModal.addEventListener("click", (e) => {
                if (e.target === addProductModal) {
                    addProductModal.classList.add("hidden");
                }
            });

            // ========================
            // LOAD DROPDOWNS
            // ========================
            async function loadDropdowns() {
                try {
                    const [catRes, dcRes] = await Promise.all([
                        fetch("/api/Category/dropdown"),
                        fetch("/api/DataCenters/dropdown")
                    ]);

                    if (!catRes.ok || !dcRes.ok) {
                        throw new Error("Failed to fetch dropdown data");
                    }

                    const categories = await catRes.json();
                    const dataCenters = await dcRes.json();

                    // Load categories for add form
                    const categorySelect = document.getElementById("category");
                    const locationSelect = document.getElementById("location");

                    categorySelect.innerHTML = '<option value="">Select Category</option>';
                    locationSelect.innerHTML = '<option value="">Select Location</option>';

                    categories.forEach(cat => {
                        const option = document.createElement("option");
                        option.value = cat.id;
                        option.textContent = cat.categoryName;
                        categorySelect.appendChild(option);
                    });

                    dataCenters.forEach(dc => {
                        const option = document.createElement("option");
                        option.value = dc.id;
                        option.textContent = dc.name;
                        locationSelect.appendChild(option);
                    });

                    // Load categories for edit form
                    const editCategorySelect = document.getElementById("editCategory");
                    const editLocationSelect = document.getElementById("editLocation");

                    editCategorySelect.innerHTML = '<option value="">Select Category</option>';
                    editLocationSelect.innerHTML = '<option value="">Select Location</option>';

                    categories.forEach(cat => {
                        const option = document.createElement("option");
                        option.value = cat.id;
                        option.textContent = cat.categoryName;
                        editCategorySelect.appendChild(option);
                    });

                    dataCenters.forEach(dc => {
                        const option = document.createElement("option");
                        option.value = dc.id;
                        option.textContent = dc.name;
                        editLocationSelect.appendChild(option);
                    });

                } catch (error) {
                    console.error("Dropdown Error:", error);
                    alert("Failed to load dropdown data");
                }
            }

            // ========================
            // SUBMIT ADD FORM
            // ========================
            addProductForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                const productData = {
                    itemCode: document.getElementById("productId").value.trim(),
                    itemName: document.getElementById("productName").value.trim(),
                    dataCenterId: parseInt(document.getElementById("location").value),
                    categoryId: parseInt(document.getElementById("category").value),
                    buyingPrice: parseFloat(document.getElementById("buyingPrice").value) || 0,
                    quantity: parseInt(document.getElementById("quantity").value) || 0,
                    dateOfPurchase: document.getElementById("dateOfPurchase").value,
                    status: document.getElementById("status").value
                };

                try {
                    const response = await fetch("/api/items", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(productData)
                    });

                    if (response.ok) {
                        alert("Product successfully added!");
                        addProductForm.reset();
                        addProductModal.classList.add("hidden");
                        loadDataCenter3Products();
                    } else {
                        const errorData = await response.json();
                        alert(`Error: ${errorData.message || "Failed to add product."}`);
                    }
                } catch (error) {
                    console.error(error);
                    alert("An error occurred while adding the product.");
                }
            });

            // ========================
            // EDIT PRODUCT
            // ========================
            const editModal = document.getElementById("editProductModal");
            const closeEditModal = document.getElementById("closeEditModal");
            const editProductForm = document.getElementById("editProductForm");
            let currentProductId = null;

            // Edit button click handler
            productTableBody.addEventListener("click", async function (e) {
                if (e.target.classList.contains("editProductButton")) {
                    const productRow = e.target.closest("tr");
                    currentProductId = productRow.dataset.id;

                    try {
                        const response = await fetch(`/api/items/${currentProductId}`, {
                            method: "GET",
                            headers: {
                                "Content-Type": "application/json"
                            }
                        });

                        if (response.ok) {
                            const product = await response.json();

                            document.getElementById("editItemId").value = product.id;
                            document.getElementById("editProductName").value = product.itemName;
                            document.getElementById("editProductId").value = product.itemCode;
                            document.getElementById("editCategory").value = product.categoryId;
                            document.getElementById("editLocation").value = product.dataCenterId;
                            document.getElementById("editBuyingPrice").value = product.buyingPrice;
                            document.getElementById("editQuantity").value = product.quantity;
                            document.getElementById("editStatus").value = product.status;

                            if (product.dateOfPurchase) {
                                const date = new Date(product.dateOfPurchase);
                                document.getElementById("editDateOfPurchase").value = date.toISOString().split('T')[0];
                            }

                            editModal.classList.remove("hidden");
                        } else {
                            alert("Failed to load product data for editing.");
                        }
                    } catch (error) {
                        console.error("Error when fetching product:", error);
                        alert("An error occurred while fetching product details.");
                    }
                }
            });

            // Close edit modal
            closeEditModal.addEventListener("click", () => {
                editModal.classList.add("hidden");
            });

            // Submit edit form
            editProductForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                const updatedData = {
                    itemName: document.getElementById("editProductName").value,
                    itemCode: document.getElementById("editProductId").value,
                    categoryId: parseInt(document.getElementById("editCategory").value),
                    dataCenterId: parseInt(document.getElementById("editLocation").value),
                    buyingPrice: parseFloat(document.getElementById("editBuyingPrice").value),
                    quantity: parseInt(document.getElementById("editQuantity").value),
                    status: document.getElementById("editStatus").value,
                    dateOfPurchase: document.getElementById("editDateOfPurchase").value
                };

                try {
                    const response = await fetch(`/api/items/${currentProductId}`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(updatedData)
                    });

                    if (response.ok) {
                        alert("Product updated successfully!");
                        editModal.classList.add("hidden");
                        loadDataCenter3Products();
                    } else {
                        alert("Failed to update product.");
                    }
                } catch (error) {
                    console.error("Error when updating product:", error);
                    alert("An error occurred. Please try again.");
                }
            });

            // ========================
            // DELETE PRODUCT
            // ========================
            const deleteModal = document.getElementById("deleteModal");
            const closeDeleteModal = document.getElementById("closeDeleteModal");
            const confirmDeleteButton = document.getElementById("confirmDeleteButton");
            const deleteProductName = document.getElementById("deleteProductName");
            let deleteProductId = null;

            productTableBody.addEventListener("click", function (e) {
                if (e.target.classList.contains("deleteProductButton")) {
                    const productRow = e.target.closest("tr");
                    deleteProductId = productRow.dataset.id;
                    const productName = productRow.querySelector(":nth-child(2)").innerText;
                    deleteProductName.textContent = productName;
                    deleteModal.classList.remove("hidden");
                }
            });

            closeDeleteModal.addEventListener("click", () => {
                deleteModal.classList.add("hidden");
            });

            confirmDeleteButton.addEventListener("click", async function () {
                if (!deleteProductId) return;

                const originalText = this.textContent;
                this.textContent = "Deleting...";
                this.disabled = true;

                try {
                    const response = await fetch(`/api/items/${deleteProductId}`, {
                        method: "DELETE",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });

                    if (response.ok) {
                        alert("Product deleted successfully!");
                        deleteModal.classList.add("hidden");
                        loadDataCenter3Products();
                        deleteProductId = null;
                    } else {
                        alert("Failed to delete product.");
                    }
                } catch (error) {
                    console.error("Error when deleting product:", error);
                    alert("An error occurred while deleting the product.");
                } finally {
                    this.textContent = originalText;
                    this.disabled = false;
                }
            });

            // ========================
            // LOAD DATA CENTER 3 PRODUCTS
            // ========================
            async function loadDataCenter3Products() {
                try {
                    const response = await fetch(`/api/items/data-center/${DATA_CENTER_ID}`, {
                        method: "GET",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`Failed to fetch products. Status: ${response.status}`);
                    }

                    const products = await response.json();
                    updateTable(products);

                } catch (error) {
                    console.error("Error while loading products:", error);
                    alert("Failed to load products for Data Center 3.");
                }
            }

            // ========================
            // UPDATE TABLE
            // ========================
            function updateTable(products) {
                productTableBody.innerHTML = "";

                if (products.length === 0) {
                    productTableBody.innerHTML = `
                        <tr>
                            <td colspan="7" class="text-center py-3">No products found</td>
                        </tr>`;
                    return;
                }

                products.forEach(product => {
                    const row = document.createElement("tr");
                    row.dataset.id = product.id;
                    row.innerHTML = `
                        <td class="px-4 py-3">${product.itemCode || "-"}</td>
                        <td class="px-4 py-3">${product.itemName || "-"}</td>
                        <td class="px-4 py-3">${product.assetNumber || "N/A"}</td>
                        <td class="px-4 py-3">
                            <span class="bg-gray-200 px-3 py-1 rounded-full text-xs">${product.categoryName || "-"}</span>
                        </td>
                        <td class="px-4 py-3">${product.dataCenterName || "-"}</td>
                        <td class="px-4 py-3">
                            <a href="/Products/Detail?id=${product.id}"
                               class="text-teal-600 bg-teal-50 px-3 py-1 rounded-full text-xs hover:bg-teal-700 hover:text-white">
                               Detail Product
                            </a>
                        </td>
                        <td class="px-4 py-3 flex gap-2">
                            <button class="editProductButton border p-2 rounded hover:bg-gray-100" data-id="${product.id}">✏️</button>
                            <button class="deleteProductButton border p-2 rounded text-red-500 hover:bg-red-50" data-id="${product.id}">🗑️</button>
                        </td>
                    `;
                    productTableBody.appendChild(row);
                });
            }

            // ========================
            // SEARCH FUNCTIONALITY
            // ========================
            searchInput.addEventListener("keypress", function (event) {
                if (event.key === "Enter") {
                    currentSearchQuery = event.target.value.trim();
                    fetchFilteredProducts(1, currentSearchQuery, currentCategoryFilter);
                }
            });

            // ========================
            // CATEGORY FILTER
            // ========================
            async function loadCategoryFilter() {
                try {
                    const response = await fetch("/api/Category/dropdown");
                    const categories = await response.json();

                    categories.forEach(cat => {
                        const option = document.createElement("option");
                        option.value = cat.id;
                        option.textContent = cat.categoryName;
                        categoryFilter.appendChild(option);
                    });
                } catch (error) {
                    console.error("Failed to load category filter", error);
                }
            }

            categoryFilter.addEventListener("change", function () {
                currentCategoryFilter = this.value;
                fetchFilteredProducts(1, currentSearchQuery, currentCategoryFilter);
            });

            // ========================
            // FETCH FILTERED PRODUCTS
            // ========================
            async function fetchFilteredProducts(page, searchQuery = "", categoryId = "") {
                const loader = document.getElementById("loader");
                if (loader) loader.classList.remove("hidden");

                try {
                    let url = `/api/items/filter?page=${page}&pageSize=${pageSize}&dataCenterId=${DATA_CENTER_ID}`;
                    if (searchQuery) url += `&search=${encodeURIComponent(searchQuery)}`;
                    if (categoryId) url += `&categoryId=${categoryId}`;

                    const response = await fetch(url, {
                        method: "GET",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`Failed to fetch products. Status: ${response.status}`);
                    }

                    const data = await response.json();
                    updateTable(data.data);
                    updatePagination(data.page, data.totalPages);
                } catch (error) {
                    console.error("Error fetching products:", error);
                    alert("Failed to fetch products. Please try again.");
                } finally {
                    if (loader) loader.classList.add("hidden");
                }
            }

            // ========================
            // UPDATE PAGINATION
            // ========================
            function updatePagination(page, totalPagesCount) {
                currentPage = page;
                totalPages = totalPagesCount;
                paginationDiv.innerHTML = "";

                if (totalPages <= 1) return;

                // Previous button
                if (currentPage > 1) {
                    paginationDiv.innerHTML += `
                        <button data-page="${currentPage - 1}" class="pagination-button px-3 py-1 bg-teal-600 text-white rounded">
                            Previous
                        </button>`;
                }

                // Page numbers
                for (let i = 1; i <= totalPages; i++) {
                    const activeClass = i === currentPage ? "bg-teal-600 text-white" : "bg-gray-300 text-black";
                    paginationDiv.innerHTML += `
                        <button data-page="${i}" class="pagination-button px-3 py-1 rounded ${activeClass}">
                            ${i}
                        </button>`;
                }

                // Next button
                if (currentPage < totalPages) {
                    paginationDiv.innerHTML += `
                        <button data-page="${currentPage + 1}" class="pagination-button px-3 py-1 bg-teal-600 text-white rounded">
                            Next
                        </button>`;
                }

                // Add event listeners
                document.querySelectorAll(".pagination-button").forEach(button => {
                    button.addEventListener("click", function () {
                        const selectedPage = parseInt(this.getAttribute("data-page"));
                        fetchFilteredProducts(selectedPage, currentSearchQuery, currentCategoryFilter);
                    });
                });
            }
        });
    </script>
</body>
</html>