@{
    ViewData["Title"] = "Detail ";
}

<body class="bg-gray-50 min-h-screen font-sans">
    <!-- Main Content -->
    <main class="p-6">
        <!-- Header -->
        <header class="flex justify-between items-center border-b pb-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-700">Product Detail</h1>
                <p class="text-sm text-gray-500">Manage Data Center 1 Products</p>
            </div>
            <!-- Action Buttons -->
            <div class="space-x-4 flex justify-between">
                <button class="bg-red-600 text-white px-4 py-2 text-sm font-medium rounded-md hover:bg-red-700 flex items-center space-x-2">
                    ✏️ <span>Edit Product</span>
                </button>
                <button class="bg-teal-600 text-white px-4 py-2 text-sm font-medium rounded-md hover:bg-teal-700 flex items-center space-x-2">
                    ✏️ <span>Edit Product</span>
                </button>
            </div>
        </header>

        <!-- Details Section -->
        <section class="mt-6 bg-white p-6 rounded-lg shadow-sm">
            <!-- Grid Container -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Primary Details -->
                <div>
                    <h2 class="text-lg font-semibold text-gray-700 mb-6">Primary Details</h2>
                    <ul class="space-y-4 text-gray-600">
                        <li><span class="font-semibold text-gray-700">Product Name:</span> Server Dell 1238</li>
                        <li><span class="font-semibold text-gray-700">PO Number:</span> 456567899999999999</li>
                        <li><span class="font-semibold text-gray-700">Asset Number:</span> h92149y812</li>
                        <li><span class="font-semibold text-gray-700">Serial Number:</span> 39492039</li>
                        <li><span class="font-semibold text-gray-700">Product Category:</span> Server</li>
                        <li><span class="font-semibold text-gray-700">Buying Price:</span>$ 80000 </li>
                        <li><span class="font-semibold text-gray-700">Quantity:</span> 1</li>
                        <li><span class="font-semibold text-gray-700">Location:</span> Data Center 1</li>
                        <li><span class="font-semibold text-gray-700">Date of Purchase:</span> 12/02/2025</li>
                        <li><span class="font-semibold text-gray-700">Status:</span> Pending</li>
                    </ul>
                </div>

                <!-- Product Image -->
                <div class="flex justify-center items-center">
                    <img src="~/images/server_dell.png" alt="Product Image" class="rounded-lg shadow-lg object-cover">
                </div>
            </div>
        </section>
    </main>
</body>
