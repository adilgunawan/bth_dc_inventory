@{
    ViewData["Title"] = "Detail Products ";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Product Detail</title>
</head>

<body class="bg-gray-50 min-h-screen font-sans">
    <main class="p-6">
        <!-- Header -->
        <header class="flex justify-between items-center border-b pb-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-700">Product Detail</h1>
                <p class="text-sm text-gray-500">Manage Data Center 1 Products</p>
            </div>
            <!-- Action Buttons -->
            <div class="space-x-4 flex">
                <!-- Delete Button -->
                <button id="openDeleteModal"
                        class="bg-red-600 text-white px-4 py-2 text-sm font-medium rounded-md hover:bg-red-700">
                    Delete Product
                </button>
                <!-- Edit Button -->
                <button id="openEditModal"
                        class="bg-teal-600 text-white px-4 py-2 text-sm font-medium rounded-md hover:bg-teal-700">
                    Edit Product
                </button>
            </div>
        </header>

        <!-- Details Section -->
        <section class="mt-6 bg-white p-6 rounded-lg shadow-sm">
            <!-- Grid for Details -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Product Details -->
                <div>
                    <h2 class="text-lg font-semibold text-gray-700 mb-6">Primary Details</h2>
                    <ul class="space-y-4 text-gray-600">
                        <li><span class="font-semibold text-gray-700">Product Name:</span> Server Dell 1238</li>
                        <li><span class="font-semibold text-gray-700">PO Number:</span> 456567899999999999</li>
                        <li><span class="font-semibold text-gray-700">Asset Number:</span> h92149y812</li>
                        <li><span class="font-semibold text-gray-700">Serial Number:</span> 39492039</li>
                        <li><span class="font-semibold text-gray-700">Product Category:</span> Server</li>
                        <li><span class="font-semibold text-gray-700">Buying Price:</span>$ 80000 </li>
                        <li><span class="font-semibold text-gray-700">Quantity:</span> 1</li>
                        <li><span class="font-semibold text-gray-700">Location:</span> Data Center 1</li>
                        <li><span class="font-semibold text-gray-700">Date of Purchase:</span> 12/02/2025</li>
                        <li><span class="font-semibold text-gray-700">Status:</span> Pending</li>
                    </ul>
                </div>

                <!-- Product Image -->
                <div class="flex justify-center items-center px-3">
                    <img src="~/images/dummy_picture.png" alt="Product Image"
                         class="rounded-lg shadow-lg object-cover">
                </div>
            </div>
        </section>
    </main>

    <!-- Modal Edit Product -->
    <div id="editModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white w-full max-w-lg rounded-lg p-6 shadow-lg">
            <h2 class="text-lg font-bold text-gray-700 mb-4">Edit Product</h2>
            <form id="editForm" class="space-y-4">
                <div>
                    <label for="productName" class="text-sm font-medium text-gray-700">Product Name</label>
                    <input type="text" id="productName"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" required />
                </div>
                <div>
                    <label for="poNumber" class="text-sm font-medium text-gray-700">PO Number</label>
                    <input type="text" id="poNumber"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" required />
                </div>
                <div>
                    <label for="assetNumber" class="text-sm font-medium text-gray-700">Asset Number</label>
                    <input type="text" id="assetNumber"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="serialNumber" class="text-sm font-medium text-gray-700">Serial Number</label>
                    <input type="text" id="serialNumber"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="category" class="text-sm font-medium text-gray-700">Product Category</label>
                    <input type="text" id="category"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="buyingPrice" class="text-sm font-medium text-gray-700">Buying Price</label>
                    <input type="text" id="buyingPrice"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="quantity" class="text-sm font-medium text-gray-700">Quantity</label>
                    <input type="number" id="quantity"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="location" class="text-sm font-medium text-gray-700">Location</label>
                    <input type="text" id="location"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="dateOfPurchase" class="text-sm font-medium text-gray-700">Date of Purchase</label>
                    <input type="date" id="dateOfPurchase"
                           class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm" />
                </div>
                <div>
                    <label for="status" class="text-sm font-medium text-gray-700">Status</label>
                    <select id="status"
                            class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm">
                        <option value="Pending">Pending</option>
                        <option value="Arrived">Arrived</option>
                    </select>
                </div>
                <div class="flex justify-end space-x-4">
                    <button type="button" id="closeEditModal"
                            class="px-4 py-2 rounded-md text-gray-500 bg-gray-100 hover:bg-gray-200">
                        Cancel
                    </button>
                    <button type="submit"
                            class="px-4 py-2 bg-teal-600 text-white rounded-md hover:bg-teal-700">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Delete Product -->
    <div id="deleteModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white rounded-lg shadow-lg p-6 w-full max-w-sm">
            <h2 class="text-lg font-bold text-gray-700 mb-4">Delete Product</h2>
            <p class="text-sm text-gray-500">Are you sure you want to delete this product? This action cannot be undone.</p>
            <div class="flex justify-end space-x-4">
                <button id="closeDeleteModal"
                        class="bg-gray-100 px-4 py-2 rounded-md text-gray-700 hover:bg-gray-200">
                    Cancel
                </button>
                <button id="confirmDeleteButton"
                        class="bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700">
                    Delete
                </button>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script>
        // Edit Modal Logic
        const editModal = document.getElementById('editModal');
        const openEditModal = document.getElementById('openEditModal');
        const closeEditModal = document.getElementById('closeEditModal');

        openEditModal.addEventListener('click', () => {
            editModal.classList.remove('hidden');
        });

        closeEditModal.addEventListener('click', () => {
            editModal.classList.add('hidden');
        });

        // Delete Modal Logic
        const deleteModal = document.getElementById('deleteModal');
        const openDeleteModal = document.getElementById('openDeleteModal');
        const closeDeleteModal = document.getElementById('closeDeleteModal');
        const confirmDeleteButton = document.getElementById('confirmDeleteButton');

        openDeleteModal.addEventListener('click', () => {
            deleteModal.classList.remove('hidden');
        });

        closeDeleteModal.addEventListener('click', () => {
            deleteModal.classList.add('hidden');
        });

        confirmDeleteButton.addEventListener('click', () => {
            alert('Product has been deleted');
            deleteModal.classList.add('hidden');
        });
    </script>
</body>
<script>
    document.addEventListener("DOMContentLoaded", async function () {

        const params = new URLSearchParams(window.location.search);
        const productId = params.get("id");

        if (!productId) {
            document.querySelector("main").innerHTML = `
                <div class="text-center mt-20">
                    <h1 class="text-2xl font-bold text-red-500">Invalid Product ID</h1>
                    <p class="text-gray-600 mt-2">Please provide a valid Product ID.</p>
                    <a href="/datacenter1" class="mt-4 inline-block text-teal-600 underline">Go Back</a>
                </div>
            `;
            return;
        }

        try {

            const response = await fetch(`/api/items/${productId}`);

            if (!response.ok) {
                throw new Error("Failed to fetch product details.");
            }

            const product = await response.json();

            const detailList = document.querySelector("ul.space-y-4");

            detailList.innerHTML = `
                <li><span class="font-semibold text-gray-700">Product Name:</span> ${product.itemName}</li>
                <li><span class="font-semibold text-gray-700">PO Number:</span> ${product.itemCode}</li>
                <li><span class="font-semibold text-gray-700">Asset Number:</span> ${product.assetNumber || "N/A"}</li>
                <li><span class="font-semibold text-gray-700">Serial Number:</span> ${product.serialNumber || "N/A"}</li>
                <li><span class="font-semibold text-gray-700">Product Category:</span><span class="bg-gray-200 px-3 py-1 rounded-full text-md"> ${product.categoryName}</span></li>
                <li><span class="font-semibold text-gray-700">Buying Price:</span> $${product.buyingPrice ? product.buyingPrice.toFixed(2) : "0.00"}</li>
                <li><span class="font-semibold text-gray-700">Quantity:</span> ${product.quantity}</li>
                <li><span class="font-semibold text-gray-700">Location:</span> ${product.dataCenterName}</li>
                <li><span class="font-semibold text-gray-700">Status:</span> ${product.status}</li>
                <li><span class="font-semibold text-gray-700">Date of Purchase:</span>
                    ${product.dateOfPurchase ? new Date(product.dateOfPurchase).toLocaleDateString() : "N/A"}
                </li>
            `;

            // Set gambar default
            const imageElement = document.querySelector(".flex img");
            if (imageElement) {
                imageElement.src = "/images/default-product.png";
            }

        } catch (error) {

            console.error("Error:", error);

            document.querySelector("main").innerHTML = `
                <div class="text-center mt-20">
                    <h1 class="text-2xl font-bold text-red-500">Failed to Load Product Details</h1>
                    <p class="text-gray-600 mt-2">Please try again later.</p>
                    <a href="/datacenter1" class="mt-4 inline-block text-teal-600 underline">Go Back</a>
                </div>
            `;
        }
    });
</script>

