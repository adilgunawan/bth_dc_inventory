@{
    ViewData["Title"] = "Products";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between my-8">
            <div>
                <h1 class="text-2xl font-semibold">Products Data</h1>
                <p class="text-gray-500">Manage Data Center Products</p>
            </div>
            <button id="openModal" class="flex items-center gap-2 bg-teal-600 text-white px-4 py-2 rounded-lg hover:bg-teal-700">
                <span class="text-xl">+</span>
                Add Product
            </button>
        </div>

        <!-- Modal ADD -->
        <div id="addProductModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
            <div class="bg-white max-w-lg w-full mx-auto rounded-lg p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-700 mb-4">New Product</h2>
                <form id="addProductForm" class="space-y-4">
                    <!-- Product Name -->
                    <div>
                        <label for="productName" class="text-sm font-medium text-gray-700">Product Name</label>
                        <input type="text" id="productName" placeholder="Enter product name"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- PO Number -->
                    <div>
                        <label for="itemCode" class="text-sm font-medium text-gray-700">PO Number</label>
                        <input type="text" id="itemCode" placeholder="Enter PO Number"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Serial Number -->
                    <!-- Serial Number -->
                    <div>
                        <label for="serialNumber" class="text-sm font-medium text-gray-700">Serial Number</label>
                        <input type="text"
                               id="serialNumber"
                               name="serialNumber"
                               placeholder="Enter serial number"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500" />
                    </div>

                    <!-- Asset Number -->
                    <div>
                        <label for="assetNumber" class="text-sm font-medium text-gray-700">Asset Number</label>
                        <input type="text"
                               id="assetNumber"
                               name="assetNumber"
                               placeholder="Enter asset number"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500" />
                    </div>

                    <!-- Category -->
                    <div>
                        <label for="category" class="text-sm font-medium text-gray-700">Category</label>
                        <select id="category"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                required>
                            <option value="">Select product category</option>
                        </select>
                    </div>

                    <!-- Buying Price -->
                    <div>
                        <label for="buyingPrice" class="text-sm font-medium text-gray-700">Buying Price $</label>
                        <input type="number" id="buyingPrice" placeholder="Enter buying price"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Quantity -->
                    <div>
                        <label for="quantity" class="text-sm font-medium text-gray-700">Quantity</label>
                        <input type="number" id="quantity" placeholder="Enter product quantity"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500"
                               required />
                    </div>

                    <!-- Location -->
                    <div>
                        <label for="location" class="text-sm font-medium text-gray-700">Location</label>
                        <select id="location"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                required>
                            <option value="">Select Location</option>
                        </select>
                    </div>

                    <!-- Date of Purchase -->
                    <div>
                        <label for="dateOfPurchase" class="text-sm font-medium text-gray-700">Date of Purchase</label>
                        <input type="date"
                               id="dateOfPurchase"
                               name="dateOfPurchase"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500" />
                    </div>

                    <!-- Status -->
                    <div>
                        <label for="status" class="text-sm font-medium text-gray-700">Status</label>
                        <select id="status"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500"
                                required>
                            <option value="">Select Status Product</option>
                            <option value="Pending">Pending</option>
                            <option value="arrived">Arrived</option>
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="flex justify-end space-x-4">
                        <button type="button" id="closeModal" class="px-4 py-2 text-sm text-gray-500 border border-gray-300 rounded-md hover:bg-gray-100">Discard</button>
                        <button type="submit" class="px-4 py-2 text-sm bg-teal-600 text-white rounded-md hover:bg-teal-700">Add Product</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Edit Product Modal -->
        <div id="editProductModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
            <div class="bg-white max-w-lg w-full mx-auto rounded-lg p-6 shadow-lg">
                <h2 class="text-xl font-semibold text-gray-700 mb-4">Edit Product</h2>
                <form id="editProductForm" class="space-y-4">
                    <input type="hidden" id="editItemId">

                    <!-- Item Code -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">PO Number</label>
                        <input type="text" id="editItemCode"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm"
                               required />
                    </div>

                    <!-- Product Name -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">Product Name</label>
                        <input type="text" id="editProductName"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm"
                               required />
                    </div>

                    <!-- Asset Number -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">Asset Number</label>
                        <input type="text" id="editAssetNumber"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm" />
                    </div>

                    <!-- Serial Number -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">Serial Number</label>
                        <input type="text" id="editSerialNumber"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm" />
                    </div>

                    <!-- Category -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">Category</label>
                        <select id="editCategory"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm"
                                required>
                            <option value="">Select Category</option>
                        </select>
                    </div>

                    <!-- Buying Price -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">Buying Price</label>
                        <input type="number" id="editBuyingPrice"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm"
                               required />
                    </div>

                    <!-- Quantity -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">Quantity</label>
                        <input type="number" id="editQuantity"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm"
                               required />
                    </div>

                    <!-- Location -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">Location</label>
                        <select id="editLocation"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm"
                                required>
                            <option value="">Select Location</option>
                        </select>
                    </div>

                    <!-- Date -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">Date of Purchase</label>
                        <input type="date" id="editDateOfPurchase"
                               class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm" />
                    </div>

                    <!-- Status -->
                    <div>
                        <label class="text-sm font-medium text-gray-700">Status</label>
                        <select id="editStatus"
                                class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm">
                            <option value="Pending">Pending</option>
                            <option value="Arrived">Arrived</option>
                            <option value="Arrived">Active</option>
                        </select>
                    </div>

                    <!-- Buttons -->
                    <div class="flex justify-end space-x-4">
                        <button type="button" id="closeEditModal"
                                class="px-4 py-2 text-sm border rounded-md">
                            Cancel
                        </button>
                        <button type="submit"
                                class="px-4 py-2 text-sm bg-teal-600 text-white rounded-md">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Modal Delete -->
        <div id="deleteModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
            <div class="bg-white w-96 rounded-lg p-6 shadow-lg">
                <h2 class="text-lg font-semibold text-gray-700 text-center mb-4">Delete Product</h2>
                <p class="text-sm text-gray-500 text-center mb-6">
                    Are you sure you want to delete
                    <span id="deleteProductName" class="font-medium text-gray-800"></span>?
                    This action cannot be undone.
                </p>
                <div class="flex justify-center space-x-4">
                    <button type="button" id="closeDeleteModal"
                            class="px-4 py-2 text-sm text-gray-500 border border-gray-300 rounded-lg hover:bg-gray-100">
                        Cancel
                    </button>
                    <button type="button" id="confirmDeleteButton"
                            class="px-4 py-2 text-sm bg-red-500 text-white rounded-lg hover:bg-red-700">
                        Yes
                    </button>
                </div>
            </div>
        </div>

        <!-- Search & Filter -->
        <div class="bg-white p-4 rounded-xl shadow-sm flex items-center m-1 mb-10">
            <div class="flex items-center bg-gray-100 rounded-lg px-3 py-2 flex-1 me-4">
                <input type="text" id="search" placeholder="Search products..."
                       class="bg-transparent outline-none flex-1 text-sm" />
            </div>
            <select id="categoryFilter" class="bg-gray-100 px-4 py-2 rounded-lg text-sm outline-none">
                <option value="">All Categories</option>
            </select>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <table id="productTable" class="w-full text-sm">
                <thead class="bg-gray-50 text-gray-600">
                    <tr>
                        <th class="text-left px-4 py-3">PO Number</th>
                        <th class="text-left px-4 py-3">Product Name</th>
                        <th class="text-left px-4 py-3">Asset Number</th>
                        <th class="text-left px-4 py-3">Category</th>
                        <th class="text-left px-4 py-3">Location</th>
                        <th class="text-left px-4 py-3">Detail Product</th>
                        <th class="text-left px-4 py-3">Action</th>
                    </tr>
                </thead>
                <tbody id="productTableBody" class="divide-y">
                    <!-- Rows akan ditambahkan secara dinamis menggunakan JavaScript -->
                </tbody>
            </table>

            <!-- Pagination -->
            <div id="pagination" class="flex justify-center gap-2 mt-4 p-4"></div>
        </div>

        <div id="loader" class="hidden text-center py-4">🔄 Loading...</div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const productTableBody = document.getElementById("productTableBody");
            const paginationDiv = document.getElementById("pagination");
            const searchInput = document.querySelector("#search");
            const categoryFilter = document.getElementById("categoryFilter");
            const pageSize = 10;
            let currentPage = 1;
            let totalPages = 0;
            let currentSearchQuery = "";
            let currentCategoryFilter = "";

            // ========================
            // LOAD INITIAL DATA
            // ========================
            fetchProducts(1);
            loadCategoryFilter();

            // ========================
            // ADD PRODUCT MODAL
            // ========================
            const form = document.getElementById("addProductForm");
            const openModal = document.getElementById("openModal");
            const closeModal = document.getElementById("closeModal");
            const addProductModal = document.getElementById("addProductModal");

            openModal.addEventListener("click", async () => {
                addProductModal.classList.remove("hidden");
                await loadDropdowns();
            });
                    // ✅ Debug date input
                const dateInput = document.getElementById("dateOfPurchase");
                console.log("Date input element:", dateInput);
                console.log("Date input type:", dateInput.type);

                // Set default date untuk testing
                const today = new Date().toISOString().split('T')[0];
                dateInput.value = today;
                console.log("Default date set:", today);

                // Add event listener untuk monitor perubahan
                dateInput.addEventListener("change", function() {
                    console.log("Date changed to:", this.value);
                });

                dateInput.addEventListener("blur", function() {
                    console.log("Date blur, final value:", this.value);
                });
            closeModal.addEventListener("click", () => {
                addProductModal.classList.add("hidden");
                form.reset();
            });

            // ========================
            // LOAD DROPDOWNS FOR ADD
            // ========================
            async function loadDropdowns() {
                try {
                    const [catRes, dcRes] = await Promise.all([
                        fetch("/api/Category/dropdown"),
                        fetch("/api/DataCenters/dropdown")
                    ]);

                    if (!catRes.ok || !dcRes.ok) {
                        throw new Error("Failed to fetch dropdown data");
                    }

                    const categories = await catRes.json();
                    const dataCenters = await dcRes.json();

                    const categorySelect = document.getElementById("category");
                    const locationSelect = document.getElementById("location");

                    categorySelect.innerHTML = '<option value="">Select Category</option>';
                    locationSelect.innerHTML = '<option value="">Select Location</option>';

                    categories.forEach(cat => {
                        const option = document.createElement("option");
                        option.value = cat.id;
                        option.textContent = cat.categoryName;
                        categorySelect.appendChild(option);
                    });

                    dataCenters.forEach(dc => {
                        const option = document.createElement("option");
                        option.value = dc.id;
                        option.textContent = dc.name;
                        locationSelect.appendChild(option);
                    });
                } catch (error) {
                    console.error("Dropdown Error:", error);
                    alert("Failed to load dropdown data");
                }
            }

            // ========================
            // SUBMIT ADD FORM
            // ========================
                    // Ganti bagian submit form dengan kode yang lebih robust:
                form.addEventListener("submit", async function (e) {
            e.preventDefault();

            // ✅ Debug semua input values
            const formData = {
                itemCode: document.getElementById("itemCode").value.trim(),
                productName: document.getElementById("productName").value.trim(),
                serialNumber: document.getElementById("serialNumber").value.trim(),
                assetNumber: document.getElementById("assetNumber").value.trim(),
                category: document.getElementById("category").value,
                location: document.getElementById("location").value,
                buyingPrice: document.getElementById("buyingPrice").value,
                quantity: document.getElementById("quantity").value,
                dateOfPurchase: document.getElementById("dateOfPurchase").value,
                status: document.getElementById("status").value
            };

            console.log("=== FORM DEBUG ===");
            console.log("Raw form data:", formData);
            console.log("Date input element:", document.getElementById("dateOfPurchase"));
            console.log("Date value type:", typeof formData.dateOfPurchase);
            console.log("Date value length:", formData.dateOfPurchase.length);

            // Validasi required fields
            if (!formData.category || !formData.location) {
                alert("Category and Location must be selected");
                return;
            }

            if (!formData.status) {
                alert("Status must be selected");
                return;
            }

            // ✅ Format data untuk API
            const productData = {
                itemCode: formData.itemCode,
                itemName: formData.productName,
                assetNumber: formData.assetNumber || null,
                serialNumber: formData.serialNumber || null,
                categoryId: parseInt(formData.category),
                dataCenterId: parseInt(formData.location),
                buyingPrice: parseFloat(formData.buyingPrice) || 0,
                quantity: parseInt(formData.quantity) || 0,
                dateOfPurchase: formData.dateOfPurchase || null, // ✅ Pastikan ini tidak kosong
                status: formData.status
            };

            console.log("=== API PAYLOAD ===");
            console.log("Sending to API:", JSON.stringify(productData, null, 2));

            try {
                const response = await fetch("/api/items", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(productData)
                });

                console.log("Response status:", response.status);
                console.log("Response headers:", response.headers);

                if (!response.ok) {
                    const errorText = await response.text();
                    console.error("Server Error Response:", errorText);
                    throw new Error(`Server returned ${response.status}: ${errorText}`);
                }

                const result = await response.json();
                console.log("Success result:", result);

                alert("Product successfully created!");
                addProductModal.classList.add("hidden");
                form.reset();
                fetchProducts(currentPage, currentSearchQuery);

            } catch (error) {
                console.error("Submit Error:", error);
                alert(`Failed to create product: ${error.message}`);
            }
        });

            // ========================
            // EDIT PRODUCT
            // ========================
            let selectedItemId = null;

            async function loadEditDropdowns() {
                try {
                    const [catRes, dcRes] = await Promise.all([
                        fetch("/api/Category/dropdown"),
                        fetch("/api/datacenters/dropdown")
                    ]);

                    const categories = await catRes.json();
                    const dataCenters = await dcRes.json();

                    const editCategorySelect = document.getElementById("editCategory");
                    const editLocationSelect = document.getElementById("editLocation");

                    editCategorySelect.innerHTML = '<option value="">Select Category</option>';
                    editLocationSelect.innerHTML = '<option value="">Select Location</option>';

                    categories.forEach(category => {
                        const option = document.createElement("option");
                        option.value = category.id;
                        option.textContent = category.categoryName;
                        editCategorySelect.appendChild(option);
                    });

                    dataCenters.forEach(location => {
                        const option = document.createElement("option");
                        option.value = location.id;
                        option.textContent = location.name;
                        editLocationSelect.appendChild(option);
                    });
                } catch (error) {
                    console.error("Failed to load edit dropdowns", error);
                }
            }

            // Load edit dropdowns on page load
            loadEditDropdowns();

            // Edit button click handler
            document.addEventListener("click", async function (e) {
                const btn = e.target.closest(".editProductButton");
                if (!btn) return;

                const itemId = btn.dataset.id;
                selectedItemId = itemId;

                try {
                    // ✅ PERBAIKI: Gunakan parentheses biasa untuk fetch
                    const response = await fetch(`/api/items/${itemId}`);
                    if (!response.ok) throw new Error("Failed to fetch product details");

                    const product = await response.json();

                    // Populate edit form
                    document.getElementById("editItemId").value = product.id;
                    document.getElementById("editItemCode").value = product.itemCode || "";
                    document.getElementById("editProductName").value = product.itemName || "";
                    document.getElementById("editAssetNumber").value = product.assetNumber || "";
                    document.getElementById("editSerialNumber").value = product.serialNumber || "";
                    document.getElementById("editCategory").value = product.categoryId || "";
                    document.getElementById("editLocation").value = product.dataCenterId || "";
                    document.getElementById("editBuyingPrice").value = product.buyingPrice || "";
                    document.getElementById("editQuantity").value = product.quantity || "";
                    document.getElementById("editStatus").value = product.status || "";

                    if (product.dateOfPurchase) {
                        const date = new Date(product.dateOfPurchase);
                        document.getElementById("editDateOfPurchase").value = date.toISOString().split('T')[0];
                    }

                    document.getElementById("editProductModal").classList.remove("hidden");
                } catch (error) {
                    console.error("Error loading product for edit:", error);
                    alert("Failed to load product details");
                }
            });

            // Close edit modal
            document.getElementById("closeEditModal").addEventListener("click", () => {
                document.getElementById("editProductModal").classList.add("hidden");
            });

            // ✅ PERBAIKI: Submit edit form
            document.getElementById("editProductForm").addEventListener("submit", async function (e) {
                e.preventDefault();

                const itemId = document.getElementById("editItemId").value;
                if (!itemId) {
                    alert("Item ID tidak ditemukan");
                    return;
                }

                // ✅ PERBAIKI: Validasi dan format data dengan benar
                const categoryId = document.getElementById("editCategory").value;
                const dataCenterId = document.getElementById("editLocation").value;
                const buyingPrice = document.getElementById("editBuyingPrice").value;
                const quantity = document.getElementById("editQuantity").value;

                if (!categoryId || !dataCenterId) {
                    alert("Category and Location must be selected");
                    return;
                }

                const data = {
                    itemCode: document.getElementById("editItemCode").value.trim(),
                    itemName: document.getElementById("editProductName").value.trim(),
                    assetNumber: document.getElementById("editAssetNumber").value.trim() || null,
                    serialNumber: document.getElementById("editSerialNumber").value.trim() || null,
                    categoryId: parseInt(categoryId),
                    dataCenterId: parseInt(dataCenterId),
                    buyingPrice: buyingPrice ? parseFloat(buyingPrice) : 0,
                    quantity: quantity ? parseInt(quantity) : 0,
                    status: document.getElementById("editStatus").value,
                    dateOfPurchase: document.getElementById("editDateOfPurchase").value || null
                };

                console.log("Sending update data:", data); // ✅ Debug log

                try {
                    // ✅ PERBAIKI: Gunakan parentheses biasa untuk fetch
                    const response = await fetch(`/api/items/${itemId}`, {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify(data)
                    });

                    if (!response.ok) {
                        // ✅ PERBAIKI: Tampilkan error detail dari server
                        const errorText = await response.text();
                        console.error("Server error:", errorText);
                        throw new Error(`Update failed: ${response.status} - ${errorText}`);
                    }

                    alert("Product updated successfully");
                    document.getElementById("editProductModal").classList.add("hidden");
                    fetchProducts(currentPage, currentSearchQuery);
                } catch (error) {
                    console.error("Update error:", error);
                    alert(`Failed to update product: ${error.message}`);
                }
            });

            // ========================
            // DELETE PRODUCT
            // ========================
            let selectedProductId = null;

            document.addEventListener("click", function (e) {
                if (e.target.closest(".deleteProductButton")) {
                    const btn = e.target.closest(".deleteProductButton");
                    selectedProductId = btn.dataset.id;
                    const row = btn.closest("tr");
                    const productName = row.children[1].innerText;
                    document.getElementById("deleteProductName").textContent = productName;
                    document.getElementById("deleteModal").classList.remove("hidden");
                }
            });

            document.getElementById("closeDeleteModal").addEventListener("click", function () {
                document.getElementById("deleteModal").classList.add("hidden");
                selectedProductId = null;
            });

            document.getElementById("confirmDeleteButton").addEventListener("click", async function () {
                if (!selectedProductId) return;

                const originalText = this.textContent;
                this.textContent = "Deleting...";
                this.disabled = true;

                try {
                    // ✅ PERBAIKI: Gunakan parentheses biasa untuk fetch
                    const response = await fetch(`/api/items/${selectedProductId}`, {
                        method: "DELETE",
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    alert("Product deleted successfully");
                    document.getElementById("deleteModal").classList.add("hidden");
                    fetchProducts(currentPage, currentSearchQuery);
                    selectedProductId = null;
                } catch (error) {
                    console.error("Delete error:", error);
                    alert("Failed to delete product. Please try again.");
                } finally {
                    this.textContent = originalText;
                    this.disabled = false;
                }
            });

            // ========================
            // FETCH PRODUCTS WITH PAGINATION
            // ========================
            async function fetchProducts(page, searchQuery = "", categoryId = "") {
                const loader = document.getElementById("loader");
                if (loader) loader.classList.remove("hidden");

                try {
                    let url = `/api/items/filter?page=${page}&pageSize=${pageSize}`;
                    if (searchQuery) url += `&search=${encodeURIComponent(searchQuery)}`;
                    if (categoryId) url += `&categoryId=${categoryId}`;

                    const response = await fetch(url, {
                        method: "GET",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });

                    if (!response.ok) {
                        throw new Error(`Failed to fetch products. Status: ${response.status}`);
                    }

                    const data = await response.json();
                    updateTable(data.data);
                    updatePagination(data.page, data.totalPages);
                } catch (error) {
                    console.error("Error fetching products:", error);
                    alert("Failed to fetch products. Please try again.");
                } finally {
                    if (loader) loader.classList.add("hidden");
                }
            }

            // ========================
            // UPDATE TABLE
            // ========================
            function updateTable(products) {
                productTableBody.innerHTML = "";

                if (products.length === 0) {
                    productTableBody.innerHTML = `
                        <tr>
                            <td colspan="7" class="text-center py-3">No products found</td>
                        </tr>`;
                    return;
                }

                products.forEach(product => {
                    const row = document.createElement("tr");
                    row.dataset.id = product.id;
                    row.innerHTML = `
                        <td class="px-4 py-3">${product.itemCode || "-"}</td>
                        <td class="px-4 py-3">${product.itemName || "-"}</td>
                        <td class="px-4 py-3">${product.assetNumber || "-"}</td>
                        <td class="px-4 py-3">
                            <span class="bg-gray-200 px-3 py-1 rounded-full text-xs">${product.categoryName || "-"}</span>
                        </td>
                        <td class="px-4 py-3">${product.dataCenterName || "-"}</td>
                        <td class="px-4 py-3">
                            <a href="/Products/Detail?id=${product.id}"
                               class="text-teal-600 bg-teal-50 px-3 py-1 rounded-full text-xs hover:bg-teal-700 hover:text-white">
                               Detail Product
                            </a>
                        </td>
                        <td class="px-4 py-3 flex gap-2">
                            <button class="editProductButton border p-2 rounded hover:bg-gray-100" data-id="${product.id}">✏️</button>
                            <button class="deleteProductButton border p-2 rounded text-red-500 hover:bg-red-50" data-id="${product.id}">🗑️</button>
                        </td>
                    `;
                    productTableBody.appendChild(row);
                });
            }

            // ========================
            // UPDATE PAGINATION
            // ========================
            function updatePagination(page, totalPagesCount) {
                currentPage = page;
                totalPages = totalPagesCount;
                paginationDiv.innerHTML = "";

                if (totalPages <= 1) return;

                // Previous button
                if (currentPage > 1) {
                    paginationDiv.innerHTML += `
                        <button data-page="${currentPage - 1}" class="pagination-button px-3 py-1 bg-teal-600 text-white rounded">
                            Previous
                        </button>`;
                }

                // Page numbers
                for (let i = 1; i <= totalPages; i++) {
                    const activeClass = i === currentPage ? "bg-teal-600 text-white" : "bg-gray-300 text-black";
                    paginationDiv.innerHTML += `
                        <button data-page="${i}" class="pagination-button px-3 py-1 rounded ${activeClass}">
                            ${i}
                        </button>`;
                }

                // Next button
                if (currentPage < totalPages) {
                    paginationDiv.innerHTML += `
                        <button data-page="${currentPage + 1}" class="pagination-button px-3 py-1 bg-teal-600 text-white rounded">
                            Next
                        </button>`;
                }

                // Add event listeners
                document.querySelectorAll(".pagination-button").forEach(button => {
                    button.addEventListener("click", function () {
                        const selectedPage = parseInt(this.getAttribute("data-page"));
                        fetchProducts(selectedPage, currentSearchQuery, currentCategoryFilter);
                    });
                });
            }

            // ========================
            // SEARCH FUNCTIONALITY
            // ========================
            searchInput.addEventListener("keypress", function (event) {
                if (event.key === "Enter") {
                    currentSearchQuery = event.target.value.trim();
                    fetchProducts(1, currentSearchQuery, currentCategoryFilter);
                }
            });

            // ========================
            // CATEGORY FILTER
            // ========================
            async function loadCategoryFilter() {
                try {
                    const response = await fetch("/api/Category/dropdown");
                    const categories = await response.json();

                    categories.forEach(cat => {
                        const option = document.createElement("option");
                        option.value = cat.id;
                        option.textContent = cat.categoryName;
                        categoryFilter.appendChild(option);
                    });
                } catch (error) {
                    console.error("Failed to load category filter", error);
                }
            }

            categoryFilter.addEventListener("change", function () {
                currentCategoryFilter = this.value;
                fetchProducts(1, currentSearchQuery, currentCategoryFilter);
            });
        });
    </script>
</body>
</html>