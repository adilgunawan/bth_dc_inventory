    <!-- Search & Filter -->
    <div class="bg-white p-4 rounded-xl shadow-sm flex items-center m-1 mb-10 ">
        <div class="flex items-center bg-gray-100 rounded-lg px-3 py-2 flex-1 me-4  ">
            <input type="text" placeholder="Search products..."
                   class="bg-transparent outline-none flex-1 text-sm" />
        </div>

        <select class="bg-gray-100 px-4 py-2 rounded-lg text-sm outline-none">
            <option>All Categories</option>
            <option>Server</option>
            <option>Cable</option>
            <option>PDU</option>
        </select>
    </div>
    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-sm">
        <tbody class="divide-y">
                <table id="productTable" class="w-full text-sm">
                    <thead class="bg-gray-50 text-gray-600">
                        <tr>
                            <th class="text-left px-4 py-3">PO Number</th>
                            <th class="text-left px-4 py-3">Product Name</th>
                            <th class="text-left px-4 py-3">Asset Number</th>
                            <th class="text-left px-4 py-3">Category</th>
                            <th class="text-left px-4 py-3">Location</th>
                            <th class="text-left px-4 py-3">Detail Product</th>
                            <th class="text-left px-4 py-3">Action</th>
                        </tr>
                    </thead>
                    <tbody id="productTableBody" class="divide-y">
                        <!-- Rows akan ditambahkan secara dinamis menggunakan JavaScript -->
                    </tbody>
                </table>
               
                
        </tbody>
    </table>
        <!-- Script Add modul -->
        <script>
            const openModal = document.getElementById("openModal");
            const closeModal = document.getElementById("closeModal");
            const addProductModal = document.getElementById("addProductModal");

            // Open Modal
            openModal.addEventListener("click", () => addProductModal.classList.remove("hidden"));

            // Close Modal
            closeModal.addEventListener("click", () => addProductModal.classList.add("hidden"));

            // Close Modal on Background Click
            addProductModal.addEventListener("click", (e) => {
              if (e.target === addProductModal) {
                addProductModal.classList.add("hidden");
              }
            });
        </script>
        <!-- Script Edit modul -->
        <script>
            const editButtons = document.querySelectorAll(".editProductButton");
            const editModal = document.getElementById("editProductModal");
            const closeEditButton = document.getElementById("closeEditModal");

            // Open Edit Modal
            editButtons.forEach((btn) => {
                btn.addEventListener("click", function () {
                    const row = this.closest("tr");
                    const poNumber = row.querySelector(":nth-child(1)").innerText;
                    const productName = row.querySelector(":nth-child(2)").innerText;
                    const productId = row.querySelector(":nth-child(3)").innerText;
                    const category = row.querySelector(":nth-child(4)").innerText.trim();
                    const location = row.querySelector(":nth-child(5)").innerText.trim();

                    // Fill the form with the row data
                    document.getElementById("editProductName").value = productName;
                    document.getElementById("editProductId").value = productId;
                    document.getElementById("editCategory").value = category;
                    document.getElementById("editLocation").value = location;

                    editModal.classList.remove("hidden");
                });
            });

            // Close Modal
            closeEditButton.addEventListener("click", () => {
                editModal.classList.add("hidden");
            });

            // Close Modal on Background Click
            editModal.addEventListener("click", (e) => {
                if (e.target === editModal) {
                    editModal.classList.add("hidden");
                }
            });
        </script>

        <!-- Script Delete modul -->
        <script>
            const deleteButtons = document.querySelectorAll(".deleteProductButton");
            const deleteModal = document.getElementById("deleteModal");
            const closeDeleteModal = document.getElementById("closeDeleteModal");
            const confirmDeleteButton = document.getElementById("confirmDeleteButton");
            const deleteProductName = document.getElementById("deleteProductName");

            let currentRow;

            // Open Delete Modal on delete button click
            deleteButtons.forEach((btn) => {
                btn.addEventListener("click", function () {
                    currentRow = this.closest("tr"); // Get the parent row of the clicked delete button
                    const productName = currentRow.querySelector(":nth-child(2)").innerText; // Get the product name
                    deleteProductName.textContent = productName; // Display product name in the modal
                    deleteModal.classList.remove("hidden"); // Show the delete modal
                });
            });

            // Close modal
            closeDeleteModal.addEventListener("click", () => {
                deleteModal.classList.add("hidden"); // Hide the delete modal
            });

            // Confirm delete action
            confirmDeleteButton.addEventListener("click", () => {
                if (currentRow) {
                    currentRow.remove(); // Remove the current row from the table
                    alert("Product has been deleted successfully!");
                }
                deleteModal.classList.add("hidden"); // Hide the modal after deletion
            });

            // Close modal on background click
            deleteModal.addEventListener("click", (e) => {
                if (e.target === deleteModal) {
                    deleteModal.classList.add("hidden");
                }
            });
        </script>

    <script>
                    async function loadProducts() {
                const productTableBody = document.getElementById("productTableBody");

                try {
                    const response = await fetch("/api/items", {
                        method: "GET",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });

                    if (response.ok) {
                        const products = await response.json();

                        // Kosongkan tabel sebelumnya
                        productTableBody.innerHTML = "";

                        // Tambahkan tiap produk ke tabel
                        products.forEach(product => {
                            const row = document.createElement("tr");
                            row.innerHTML = `
                                <td class="px-4 py-3">${product.itemCode}</td>
                                <td class="px-4 py-3">${product.itemName}</td>
                                <td class="px-4 py-3">${product.assetNumber || "-"}</td>
                                <td class="px-4 py-3">
                                    <span class="bg-gray-200 px-3 py-1 rounded-full text-xs">${product.categoryName}</span>
                                </td>
                                <td class="px-4 py-3">${product.dataCenterName}</td>
                                <td class="px-4 py-3">
                                    <a href="#" class="text-teal-600 bg-teal-50 px-3 py-1 rounded-full text-xs hover:bg-teal-700 hover:text-white">Detail Product</a>
                                </td>
                                <td class="px-4 py-3 flex gap-2">
                                    <button class="editProductButton border p-2 rounded hover:bg-gray-100">✏️</button>
                                    <button class="deleteProductButton border p-2 rounded text-red-500 hover:bg-red-50">🗑️</button>
                                </td>
                            `;
                            productTableBody.appendChild(row);
                        });
                    } else {
                        console.error("Failed to load products:", response.status);
                    }
                } catch (error) {
                    console.error("Error loading products:", error);
                }
            }
    </script>
</div>

    
</div>
<!-- SCRIPT NGAMBIL SEMUA DATA DARI DATABASE -->
<script>
        document.addEventListener("DOMContentLoaded", function () {
        const productTableBody = document.getElementById("productTableBody");

        // Fungsi untuk memuat semua produk dari API
        async function loadProducts() {
            try {
                const response = await fetch("/api/items", {
                    method: "GET",
                    headers: {
                        "Content-Type": "application/json"
                    }
                });

                if (!response.ok) {
                    throw new Error(`Failed to load products: ${response.status}`);
                }

                const products = await response.json();

                // Clear existing rows
                productTableBody.innerHTML = "";

                // Render rows secara dinamis
                products.forEach(product => {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td class="px-4 py-3">${product.itemCode}</td>
                        <td class="px-4 py-3">${product.itemName}</td>
                        <td class="px-4 py-3">${product.assetNumber || "-"}</td>
                        <td class="px-4 py-3">
                            <span class="bg-gray-200 px-3 py-1 rounded-full text-xs">${product.categoryName}</span>
                        </td>
                        <td class="px-4 py-3">${product.dataCenterName}</td>
                        <td class="px-4 py-3">
                            <a href="#"
                               class="text-teal-600 bg-teal-50 px-3 py-1 rounded-full text-xs hover:bg-teal-700 hover:text-white transition ease-in-out duration-500">
                               Detail Product
                            </a>
                        </td>
                        <td class="px-4 py-3 flex gap-2">
                            <button class="editProductButton border p-2 rounded hover:bg-gray-100">✏️</button>
                            <button class="deleteProductButton border p-2 rounded text-red-500 hover:bg-red-50">🗑️</button>
                        </td>
                    `;
                    productTableBody.appendChild(row);
                });
            } catch (error) {
                console.error(error);
                alert("Error loading products.");
            }
        }

        // Panggil fungsi untuk memuat produk saat halaman dimuat
        loadProducts();
    });
</script>
<!-- SCRIPT ADD DATA KE DATABASE -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const addProductForm = document.getElementById("addProductForm");
        const addProductModal = document.getElementById("addProductModal");
        const closeModal = document.getElementById("closeModal");

        addProductForm.addEventListener("submit", async function (e) {
            e.preventDefault(); // Mencegah reload halaman

            // Ambil data dari form
            const productData = {
                itemCode: document.getElementById("itemCode").value.trim(),
                itemName: document.getElementById("productName").value.trim(),
                assetNumber: document.getElementById("assetNumber").value.trim(),
                serialNumber: document.getElementById("serialNumber").value.trim(),
                categoryId: parseInt(document.getElementById("category").value),
                dataCenterId: parseInt(document.getElementById("location").value),
                buyingPrice: parseFloat(document.getElementById("buyingPrice").value),
                quantity: parseInt(document.getElementById("quantity").value),
                dateOfPurchase: document.getElementById("dateOfPurchase").value,
                status: document.getElementById("status").value
            };

            try {
                // Kirim data ke backend
                const response = await fetch("/api/items", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(productData)
                });

                if (response.ok) {
                    const result = await response.json();
                    alert(result.message); // Tampilkan pesan sukses
                    addProductModal.classList.add("hidden"); // Tutup modal
                    addProductForm.reset(); // Reset form
                    loadProducts(); // Refresh produk di tabel
                } else {
                    const errorData = await response.json();
                    alert(`Error adding product: ${errorData.message}`);
                }
            } catch (error) {
                console.error("Error occurred:", error);
                alert("An unexpected error occurred. Please try again.");
            }
        });

        // Close modal
        closeModal.addEventListener("click", () => addProductModal.classList.add("hidden"));
    });
</script>

<!-- SCRIPT HAPUS DATA DARI DATABASE -->
<script>
        const deleteButtons = document.querySelectorAll(".deleteProductButton");
    deleteButtons.forEach(button => {
        button.addEventListener("click", async function () {
            const productId = this.getAttribute("data-id");

            try {
                const response = await fetch(`/api/items/${productId}`, {
                    method: "DELETE"
                });

                if (response.ok) {
                    alert("Product deleted successfully!");
                    // Reload products
                    loadProducts();
                } else {
                    alert("Failed to delete product.");
                }
            } catch (error) {
                console.error(error);
                alert("An error occurred while deleting the product.");
            }
        });
    });
</script>

<!--FILTER CATGORY!-->
<script>
        document.addEventListener("DOMContentLoaded", () => {
        const productTableBody = document.getElementById("productTableBody");
        const categorySelect = document.getElementById("category");

        // Fungsi untuk memuat produk berdasarkan kategori
        async function loadProductsByCategory(categoryId) {
            try {
                const response = await fetch(`/api/items/filter-by-category?categoryId=${categoryId}`, {
                    method: "GET",
                    headers: {
                        "Content-Type": "application/json"
                    }
                });

                if (response.ok) {
                    const products = await response.json();

                    // Kosongkan tabel
                    productTableBody.innerHTML = "";

                    // Tampilkan data produk
                    products.forEach(product => {
                        const row = document.createElement("tr");
                        row.innerHTML = `
                            <td class="px-4 py-3">${product.itemCode}</td>
                            <td class="px-4 py-3">${product.itemName}</td>
                            <td class="px-4 py-3">${product.assetNumber || "-"}</td>
                            <td class="px-4 py-3">${product.categoryName}</td>
                            <td class="px-4 py-3">${product.dataCenterName}</td>
                            <td class="px-4 py-3">
                                <a href="#" class="text-teal-600 bg-teal-50 px-3 py-1 rounded-full text-xs hover:bg-teal-700 hover:text-white">
                                    Detail Product
                                </a>
                            </td>
                            <td class="px-4 py-3 flex gap-2">
                                <button class="editProductButton border p-2 rounded hover:bg-gray-100">✏️</button>
                                <button class="deleteProductButton border p-2 rounded text-red-500 hover:bg-red-50">🗑️</button>
                            </td>
                        `;
                        productTableBody.appendChild(row);
                    });
                } else {
                    throw new Error("Failed to load products for this category.");
                }
            } catch (error) {
                console.error(error);
                alert(error.message || "An error occurred while fetching the products.");
            }
        }

        // Tambahkan event listener pada dropdown kategori
        categorySelect.addEventListener("change", (e) => {
            const selectedCategory = parseInt(e.target.value);

            if (isNaN(selectedCategory)) {
                // Jika kategori tidak valid, muat semua produk
                loadProducts(); // Fungsi untuk memuat semua data
            } else {
                // Muat data berdasarkan kategori yang dipilih
                loadProductsByCategory(selectedCategory);
            }
        });

        // Fungsi untuk memuat semua produk saat halaman pertama kali dimuat
        async function loadProducts() {
            try {
                const response = await fetch(`/api/items`, {
                    method: "GET",
                    headers: {
                        "Content-Type": "application/json"
                    }
                });

                if (!response.ok) {
                    throw new Error(`Failed to load products: ${response.status}`);
                }

                const products = await response.json();

                // Kosongkan tabel
                productTableBody.innerHTML = "";

                // Tambahkan produk ke tabel
                products.forEach(product => {
                    const row = document.createElement("tr");
                    row.innerHTML = `
                        <td class="px-4 py-3">${product.itemCode}</td>
                        <td class="px-4 py-3">${product.itemName}</td>
                        <td class="px-4 py-3">${product.assetNumber || "-"}</td>
                        <td class="px-4 py-3">${product.categoryName}</td>
                        <td class="px-4 py-3">${product.dataCenterName}</td>
                        <td class="px-4 py-3">
                            <a href="#" class="text-teal-600 bg-teal-50 px-3 py-1 rounded-full text-xs hover:bg-teal-700 hover:text-white">
                                Detail Product
                            </a>
                        </td>
                        <td class="px-4 py-3 flex gap-2">
                            <button class="editProductButton border p-2 rounded hover:bg-gray-100">✏️</button>
                            <button class="deleteProductButton border p-2 rounded text-red-500 hover:bg-red-50">🗑️</button>
                        </td>
                    `;
                    productTableBody.appendChild(row);
                });
            } catch (error) {
                console.error("Error loading products:", error);
                alert("Failed to load products.");
            }
        }

        // Muat semua data saat pertama kali halaman dimuat
        loadProducts();
    });
</script>
<script>
        async function loadCategories() {
        const categorySelect = document.getElementById("category");

        try {
            const response = await fetch("/api/items/categories", {
                method: "GET",
                headers: {
                    "Content-Type": "application/json"
                }
            });

            if (response.ok) {
                const categories = await response.json();
                categorySelect.innerHTML = '<option value="">All Categories</option>';

                categories.forEach((category) => {
                    categorySelect.innerHTML += `<option value="${category.id}">${category.categoryName}</option>`;
                });
            } else {
                throw new Error("Failed to load categories.");
            }
        } catch (error) {
            console.error("Error loading categories:", error);
        }
    }

    // Muat kategori saat halaman dimuat
    document.addEventListener("DOMContentLoaded", loadCategories);
</script>
</html>