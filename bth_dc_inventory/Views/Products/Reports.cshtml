@{
    ViewData["Title"] = "Reports ";
}

<body class="bg-gray-50 min-h-screen font-sans flex">


    <!-- Main Content -->
    <main class="flex-1 p-6">
        <!-- Header -->
        <header class="flex justify-between items-center border-b pb-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-700">Reports</h1>
                <p class="text-sm text-gray-500">Generate and view reports based on product data</p>
            </div>
            <button class="bg-teal-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-teal-700">
                + Generate Report
            </button>
        </header>

        <!-- Filters and Calendar -->
        <section class="mt-6 bg-white shadow rounded-lg p-6 flex justify-between gap-6">
            <!-- Calendar -->
            <div class="w-1/3">
                <h2 class="text-lg font-semibold text-gray-700 mb-4">Select Date</h2>
                <input type="date" class="w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:ring-teal-500 focus:outline-none">
            </div>

            <!-- Chart -->
            <div class="flex-1">
                <h2 class="text-lg font-semibold text-gray-700 mb-4">Report Summary</h2>
                <canvas id="reportChart" class="w-full h-48"></canvas>
            </div>
        </section>

        <!-- Report Table -->
        <section class="mt-6 bg-white shadow rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Report List</h2>
            <table class="w-full border-collapse border border-gray-200 text-sm">
                <thead class="bg-gray-100 text-gray-600">
                    <tr>
                        <th class="p-3 text-left">#</th>
                        <th class="p-3 text-left">Report Name</th>
                        <th class="p-3 text-left">Category</th>
                        <th class="p-3 text-left">Date Created</th>
                        <th class="p-3 text-left">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <!-- Row 1 -->
                    <tr>
                        <td class="p-3">1</td>
                        <td class="p-3">Monthly Inventory</td>
                        <td class="p-3">
                            <span class="px-2 py-1 bg-teal-100 text-teal-800 rounded-full text-xs">Inventory</span>
                        </td>
                        <td class="p-3 text-gray-500">2023-12-01</td>
                        <td class="p-3">
                            <button class="text-teal-600 hover:underline">View</button>
                            <button class="text-red-600 hover:underline ml-4">Delete</button>
                        </td>
                    </tr>
                    <!-- Row 2 -->
                    <tr>
                        <td class="p-3">2</td>
                        <td class="p-3">Weekly Server Check</td>
                        <td class="p-3">
                            <span class="px-2 py-1 bg-gray-200 text-gray-600 rounded-full text-xs">Status</span>
                        </td>
                        <td class="p-3 text-gray-500">2023-12-05</td>
                        <td class="p-3">
                            <button class="text-teal-600 hover:underline">View</button>
                            <button class="text-red-600 hover:underline ml-4">Delete</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </section>
    </main>

    <!-- Chart.js Configuration -->
    <script>
        const ctx = document.getElementById('reportChart').getContext('2d');
        new Chart(ctx, {
          type: 'pie',
          data: {
            labels: ['Server', 'Cable', 'PDU'],
            datasets: [{
              data: [55, 25, 20],
              backgroundColor: ['#4CAF50', '#FF9800', '#03A9F4'],
            }]
          }
        });
    </script>
</body>