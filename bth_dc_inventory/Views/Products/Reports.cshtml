@{
    ViewData["Title"] = "Reports ";
}


<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Reports</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen font-sans">
    <div class="container mx-auto p-6">
        <!-- Header -->
        <header class="mb-6">
            <h1 class="text-3xl font-bold text-gray-700">Inventory Reports</h1>
            <p class="text-sm text-gray-500">View and export inventory data by date range</p>
        </header>

        <!-- Filters -->
        <!-- Filters -->
        <section class="bg-white shadow-md rounded-lg p-6 mb-6">
            <h2 class="text-lg font-bold text-gray-700 mb-4">Filters</h2>
            <!-- Date Range -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center mb-6">
                <div>
                    <label class="text-sm font-medium text-gray-600 mb-2 block">Date Range</label>
                    <input type="date" id="startDate"
                           class="w-full h-10 border border-gray-300 rounded-md px-3 text-sm text-gray-500"
                           placeholder="Start Date">
                    <input type="date" id="endDate"
                           class="w-full h-10 border border-gray-300 rounded-md px-3 text-sm mt-2 text-gray-500"
                           placeholder="End Date">
                </div>
                <div class="flex items-start">
                    <button id="applyFilter"
                            class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium shadow hover:bg-blue-700 h-10">
                        Apply Filter
                    </button>
                </div>
            </div>
        </section>

        <!-- Stats -->
        <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Total Entries</p>
                    <p class="text-3xl font-bold text-teal-600">156</p>
                </div>
                <div class="bg-teal-100 text-teal-600 rounded-full p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M20 6H9M15 6L20 11M20 11L15 16M9 6V16"></path>
                    </svg>
                </div>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">New Items</p>
                    <p class="text-3xl font-bold text-green-600">42</p>
                </div>
                <div class="bg-green-100 text-green-600 rounded-full p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M12 5v14m7-7H5"></path>
                    </svg>
                </div>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Updated Items</p>
                    <p class="text-3xl font-bold text-orange-500">38</p>
                </div>
                <div class="bg-orange-100 text-orange-600 rounded-full p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M17 4L8 12m0 8l9-8"></path>
                    </svg>
                </div>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Data Centers</p>
                    <p class="text-3xl font-bold text-purple-600">3</p>
                </div>
                <div class="bg-purple-100 text-purple-600 rounded-full p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2">
                        <path d="M9 11H5m4 8H5m16-8h-6"></path>
                    </svg>
                </div>
            </div>
        </section>

        <!-- Export Section -->
        <section class="bg-white shadow-md rounded-lg p-6 mb-6">
            <h2 class="text-lg font-bold text-gray-700 mb-4">Export Report</h2>
            <div class="flex gap-4">
                <button class="bg-red-500 text-white px-4 py-2 rounded-md shadow hover:bg-red-600">
                    Export PDF
                </button>
                <button class="bg-green-500 text-white px-4 py-2 rounded-md shadow hover:bg-green-600">
                    Export Excel
                </button>
            </div>
        </section>

        <!-- Report Table -->
        <section class="bg-white shadow-md rounded-lg p-6">
            <h2 class="text-lg font-bold text-gray-700 mb-4">Report Data</h2>
            <table class="w-full border-collapse">
                <thead class="bg-gray-100 border-b">
                    <tr class="text-gray-600 text-left text-sm">
                        <th class="p-3">ID</th>
                        <th class="p-3">Date & Time</th>
                        <th class="p-3">Item Name</th>
                        <th class="p-3">Category</th>
                        <th class="p-3">Quantity</th>
                        <th class="p-3">Data Center</th>
                        <th class="p-3">Status</th>
                        <th class="p-3">Added By</th>
                    </tr>
                </thead>
                <tbody id="reportTable" class="text-gray-600 text-sm">
                    <tr>
                        <td class="p-3">INV-00087</td>
                        <td class="p-3">Feb 3, 2026</td>
                        <td class="p-3">Server Unit 24</td>
                        <td class="p-3"><span class="bg-green-100 text-green-600 rounded-full px-3 py-1">Switch</span></td>
                        <td class="p-3">10</td>
                        <td class="p-3">Data Center 2</td>
                        <td class="p-3"><span class="bg-blue-100 text-blue-600 rounded-full px-3 py-1">Added</span></td>
                        <td class="p-3">John Doe</td>
                    </tr>
                </tbody>
            </table>
        </section>
    </div>

    <script>
        // Handle Quick Select
        document.querySelectorAll('.quick-select').forEach(btn => {
            btn.addEventListener('click', () => {
                alert(`Filter applied for ${btn.dataset.quickselect}`);
            });
        });

        // Handle Apply Filter
        document.getElementById('applyFilter').addEventListener('click', () => {
            alert('Filter applied for specific date range.');
        });
    </script>
</body>

</html>

