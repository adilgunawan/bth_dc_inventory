@{
    ViewData["Title"] = "Reports";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Reports</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen font-sans">
    <div class="container mx-auto p-6">
        <!-- Header -->
        <header class="mb-6">
            <h1 class="text-3xl font-bold text-gray-700">Inventory Reports</h1>
            <p class="text-sm text-gray-500">View and export inventory data by purchase date range</p>
        </header>

        <!-- Filters -->
        <section class="bg-white shadow-md rounded-lg p-6 mb-6">
            <h2 class="text-lg font-bold text-gray-700 mb-4">Filter by Purchase Date</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
                <!-- Date Range -->
                <div>
                    <label class="text-sm font-medium text-gray-600 mb-2 block">Purchase Start Date</label>
                    <input type="date" id="startDate"
                           class="w-full h-10 border border-gray-300 rounded-md px-3 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-600 mb-2 block">Purchase End Date</label>
                    <input type="date" id="endDate"
                           class="w-full h-10 border border-gray-300 rounded-md px-3 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <!-- Quick Select & Apply Button -->
                <div class="flex gap-2">
                    <select id="quickSelect" class="h-10 border border-gray-300 rounded-md px-3 text-sm bg-white">
                        <option value="">Select Range</option>
                        <option value="7">Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="90">Last 3 months</option>
                        <option value="365">Last year</option>
                    </select>
                    <button id="applyFilter"
                            class="px-6 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium shadow hover:bg-blue-700 transition">
                        Apply Filter
                    </button>
                </div>
            </div>
        </section>

        <!-- Loading State -->
        <div id="loadingState" class="text-center py-8 hidden">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
            <p class="text-gray-600">Loading report data...</p>
        </div>

        <!-- Stats -->
        <section id="statsSection" class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Total Items</p>
                    <p id="totalEntries" class="text-3xl font-bold text-teal-600">0</p>
                </div>
                <div class="bg-teal-100 text-teal-600 rounded-full p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" />
                    </svg>
                </div>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Total Value</p>
                    <p id="totalValue" class="text-3xl font-bold text-green-600">$0</p>
                </div>
                <div class="bg-green-100 text-green-600 rounded-full p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                    </svg>
                </div>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Categories</p>
                    <p id="totalCategories" class="text-3xl font-bold text-orange-500">0</p>
                </div>
                <div class="bg-orange-100 text-orange-600 rounded-full p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                    </svg>
                </div>
            </div>
            <div class="bg-white shadow-md rounded-lg p-6 flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500">Data Centers</p>
                    <p id="totalDataCenters" class="text-3xl font-bold text-purple-600">0</p>
                </div>
                <div class="bg-purple-100 text-purple-600 rounded-full p-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M4 6v2h16V6H4zm0 5v3h16v-3H4zm0 8v2h16v-2H4z" />
                    </svg>
                </div>
            </div>
        </section>

        <!-- Export Section -->
        <section class="bg-white shadow-md rounded-lg p-6 mb-6">
            <h2 class="text-lg font-bold text-gray-700 mb-4">Export Report by Purchase Date</h2>
            <div class="flex gap-4 items-center">
                <button id="exportPDF" class="bg-red-500 text-white px-6 py-2 rounded-md shadow hover:bg-red-600 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    📄 Export PDF
                </button>
                <button id="exportExcel" class="bg-green-500 text-white px-6 py-2 rounded-md shadow hover:bg-green-600 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    📊 Export Excel
                </button>
                <span id="exportStatus" class="text-sm text-gray-500"></span>
            </div>
        </section>

        <!-- Report Table -->
        <section class="bg-white shadow-md rounded-lg p-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-bold text-gray-700">Items by Purchase Date</h2>
                <div class="text-sm text-gray-500">
                    Showing <span id="showingFrom">0</span>-<span id="showingTo">0</span> of <span id="totalCount">0</span> entries
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                    <thead class="bg-gray-100 border-b">
                        <tr class="text-gray-600 text-left text-sm">
                            <th class="p-3">Item Code</th>
                            <th class="p-3">Item Name</th>
                            <th class="p-3">Purchase Date</th>
                            <th class="p-3">Category</th>
                            <th class="p-3">Quantity</th>
                            <th class="p-3">Unit Price</th>
                            <th class="p-3">Total Value</th>
                            <th class="p-3">Data Center</th>
                            <th class="p-3">Status</th>
                        </tr>
                    </thead>
                    <tbody id="reportTable" class="text-gray-600 text-sm">
                        <!-- Data will be populated here -->
                    </tbody>
                </table>
            </div>
            <!-- Pagination -->
            <div id="pagination" class="flex justify-center items-center gap-2 mt-6">
                <!-- Pagination buttons will be generated here -->
            </div>
            <!-- Empty State -->
            <div id="emptyState" class="text-center py-8 hidden">
                <div class="text-gray-400 text-6xl mb-4">📊</div>
                <h3 class="text-xl font-semibold text-gray-600 mb-2">No Data Found</h3>
                <p class="text-gray-500">Try adjusting your purchase date range or filters</p>
            </div>
        </section>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let currentPage = 1;
            let currentDateRange = {};

            // Initialize with last 30 days
            const today = new Date();
            const thirtyDaysAgo = new Date(today.getTime() - 30 * 24 * 60 * 60 * 1000);
            document.getElementById("startDate").value = thirtyDaysAgo.toISOString().split('T')[0];
            document.getElementById("endDate").value = today.toISOString().split('T')[0];

            loadReportData();

            // ========================
            // EVENT LISTENERS
            // ========================
            document.getElementById("quickSelect").addEventListener("change", function() {
                const days = parseInt(this.value);
                if (days) {
                    const end = new Date();
                    const start = new Date(end.getTime() - days * 24 * 60 * 60 * 1000);
                    document.getElementById("startDate").value = start.toISOString().split('T')[0];
                    document.getElementById("endDate").value = end.toISOString().split('T')[0];
                }
            });

            document.getElementById("applyFilter").addEventListener("click", function() {
                currentPage = 1;
                loadReportData();
            });

            document.getElementById("exportPDF").addEventListener("click", exportToPDF);
            document.getElementById("exportExcel").addEventListener("click", exportToExcel);

            // ========================
            // LOAD REPORT DATA - BERDASARKAN PURCHASE DATE
            // ========================
            async function loadReportData() {
                try {
                    showLoading(true);

                    const startDate = document.getElementById("startDate").value;
                    const endDate = document.getElementById("endDate").value;

                    if (!startDate || !endDate) {
                        alert("Please select both purchase start and end dates");
                        showLoading(false);
                        return;
                    }

                    currentDateRange = { startDate, endDate };

                    // ✅ UBAH: API call berdasarkan purchase date
                    const [statsResponse, dataResponse] = await Promise.all([
                        fetch(`/api/reports/stats-by-purchase-date?startDate=${startDate}&endDate=${endDate}`),
                        fetch(`/api/reports/data-by-purchase-date?startDate=${startDate}&endDate=${endDate}&page=${currentPage}&pageSize=50`)
                    ]);

                    if (!statsResponse.ok || !dataResponse.ok) {
                        throw new Error("Failed to fetch report data");
                    }

                    const stats = await statsResponse.json();
                    const data = await dataResponse.json();

                    updateStats(stats);
                    updateTable(data);
                    updatePagination(data);
                    showLoading(false);

                } catch (error) {
                    console.error("Error loading report data:", error);
                    showError("Failed to load report data. Please try again.");
                    showLoading(false);
                }
            }

            // ========================
            // UPDATE STATS - UNTUK PURCHASE DATE
            // ========================
            function updateStats(stats) {
                document.getElementById("totalEntries").textContent = stats.totalItems || 0;
                document.getElementById("totalValue").textContent = `$${(stats.totalValue || 0).toLocaleString()}`;
                document.getElementById("totalCategories").textContent = stats.totalCategories || 0;
                document.getElementById("totalDataCenters").textContent = stats.totalDataCenters || 0;
            }

            // ========================
            // UPDATE TABLE - FOKUS PADA PURCHASE DATE
            // ========================
            function updateTable(data) {
                const tableBody = document.getElementById("reportTable");
                const emptyState = document.getElementById("emptyState");

                if (!data.data || data.data.length === 0) {
                    tableBody.innerHTML = "";
                    emptyState.classList.remove("hidden");
                    return;
                }

                emptyState.classList.add("hidden");

                tableBody.innerHTML = data.data.map(item => `
                    <tr class="border-b hover:bg-gray-50">
                        <td class="p-3 font-medium">${item.itemCode || '-'}</td>
                        <td class="p-3">${item.itemName}</td>
                        <td class="p-3">
                            <span class="text-blue-600 font-medium">
                                ${item.dateOfPurchase ? new Date(item.dateOfPurchase).toLocaleDateString('en-GB') : 'Not Set'}
                            </span>
                        </td>
                        <td class="p-3">
                            <span class="bg-blue-100 text-blue-600 rounded-full px-3 py-1 text-xs">
                                ${item.categoryName}
                            </span>
                        </td>
                        <td class="p-3 text-center">${item.quantity}</td>
                        <td class="p-3">$${(item.buyingPrice || 0).toLocaleString()}</td>
                        <td class="p-3 font-medium">$${((item.buyingPrice || 0) * (item.quantity || 0)).toLocaleString()}</td>
                        <td class="p-3">${item.dataCenterName}</td>
                        <td class="p-3">
                            <span class="px-3 py-1 rounded-full text-xs ${getStatusColor(item.status)}">
                                ${item.status}
                            </span>
                        </td>
                    </tr>
                `).join("");

                // Update showing info
                const from = (data.page - 1) * data.pageSize + 1;
                const to = Math.min(from + data.data.length - 1, data.totalCount);
                document.getElementById("showingFrom").textContent = from;
                document.getElementById("showingTo").textContent = to;
                document.getElementById("totalCount").textContent = data.totalCount;
            }

            // ========================
            // UPDATE PAGINATION
            // ========================
            function updatePagination(data) {
                const pagination = document.getElementById("pagination");

                if (data.totalPages <= 1) {
                    pagination.innerHTML = "";
                    return;
                }

                let paginationHTML = "";

                // Previous button
                if (data.page > 1) {
                    paginationHTML += `
                        <button onclick="changePage(${data.page - 1})"
                                class="px-3 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                            Previous
                        </button>
                    `;
                }

                // Page numbers
                const maxVisible = 5;
                let startPage = Math.max(1, data.page - Math.floor(maxVisible / 2));
                let endPage = Math.min(data.totalPages, startPage + maxVisible - 1);

                if (endPage - startPage + 1 < maxVisible) {
                    startPage = Math.max(1, endPage - maxVisible + 1);
                }

                for (let i = startPage; i <= endPage; i++) {
                    const activeClass = i === data.page ? "bg-blue-600 text-white" : "bg-white text-gray-700 hover:bg-gray-100";
                    paginationHTML += `
                        <button onclick="changePage(${i})"
                                class="px-3 py-2 border rounded ${activeClass}">
                            ${i}
                        </button>
                    `;
                }

                // Next button
                if (data.page < data.totalPages) {
                    paginationHTML += `
                        <button onclick="changePage(${data.page + 1})"
                                class="px-3 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                            Next
                        </button>
                    `;
                }

                pagination.innerHTML = paginationHTML;
            }

            // ========================
            // PAGINATION CHANGE
            // ========================
            window.changePage = function(page) {
                currentPage = page;
                loadReportData();
            };

            // ========================
            // EXPORT FUNCTIONS - BERDASARKAN PURCHASE DATE
            // ========================
            async function exportToPDF() {
                try {
                    console.log("Starting PDF export by purchase date...");
                    setExportLoading("exportPDF", true);

                    const { startDate, endDate } = currentDateRange;
                    if (!startDate || !endDate) {
                        throw new Error("Purchase date range not selected");
                    }

                    console.log("Requesting PDF with purchase dates:", startDate, endDate);

                    // ✅ UBAH: Export berdasarkan purchase date
                    const response = await fetch(`/api/reports/export/pdf-by-purchase-date?startDate=${startDate}&endDate=${endDate}`);

                    console.log("Response status:", response.status);

                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error("Server error:", errorText);
                        throw new Error(`Server error: ${response.status} - ${errorText}`);
                    }

                    const blob = await response.blob();
                    console.log("Blob size:", blob.size);

                    if (blob.size === 0) {
                        throw new Error("Empty file received");
                    }

                    downloadFile(blob, `InventoryReport_PurchaseDate_${startDate}_${endDate}.pdf`);
                    showExportSuccess("PDF exported successfully!");

                } catch (error) {
                    console.error("Error exporting PDF:", error);
                    showError(`Failed to export PDF: ${error.message}`);
                } finally {
                    setExportLoading("exportPDF", false);
                }
            }

            async function exportToExcel() {
                try {
                    console.log("Starting Excel export by purchase date...");
                    setExportLoading("exportExcel", true);

                    const { startDate, endDate } = currentDateRange;
                    if (!startDate || !endDate) {
                        throw new Error("Purchase date range not selected");
                    }

                    // ✅ UBAH: Export berdasarkan purchase date
                    const response = await fetch(`/api/reports/export/excel-by-purchase-date?startDate=${startDate}&endDate=${endDate}`);

                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error("Server error:", errorText);
                        throw new Error(`Server error: ${response.status}`);
                    }

                    const blob = await response.blob();
                    if (blob.size === 0) {
                        throw new Error("Empty file received");
                    }

                    downloadFile(blob, `InventoryReport_PurchaseDate_${startDate}_${endDate}.xlsx`);
                    showExportSuccess("Excel exported successfully!");

                } catch (error) {
                    console.error("Error exporting Excel:", error);
                    showError(`Failed to export Excel: ${error.message}`);
                } finally {
                    setExportLoading("exportExcel", false);
                }
            }

            // Helper function untuk download
            function downloadFile(blob, filename) {
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
            }

            // ========================
            // UTILITY FUNCTIONS
            // ========================
            function showLoading(show) {
                document.getElementById("loadingState").classList.toggle("hidden", !show);
                document.getElementById("statsSection").classList.toggle("opacity-50", show);
            }

            function showError(message) {
                const toast = createToast(message, 'error');
                document.body.appendChild(toast);
            }

            function showExportSuccess(message) {
                const toast = createToast(message, 'success');
                document.body.appendChild(toast);
            }

            function createToast(message, type) {
                const toast = document.createElement('div');
                toast.className = `fixed top-4 right-4 p-4 rounded-lg shadow-lg z-50 ${
                    type === 'success' ? 'bg-green-500' : 'bg-red-500'
                } text-white max-w-sm`;
                toast.textContent = message;
                setTimeout(() => {
                    toast.remove();
                }, 3000);
                return toast;
            }

            function setExportLoading(buttonId, loading) {
                const button = document.getElementById(buttonId);
                const status = document.getElementById("exportStatus");
                button.disabled = loading;

                if (loading) {
                    status.textContent = "Generating file...";
                    status.className = "text-sm text-blue-600";
                } else {
                    status.textContent = "";
                    status.className = "text-sm text-gray-500";
                }
            }

            function getStatusColor(status) {
                switch(status?.toLowerCase()) {
                    case 'pending': return 'bg-yellow-100 text-yellow-800';
                    case 'arrived': return 'bg-green-100 text-green-800';
                    case 'active': return 'bg-blue-100 text-blue-800';
                    default: return 'bg-gray-100 text-gray-800';
                }
            }
        });
    </script>
</body>
</html>