@{
    ViewData["Title"] = "Settings";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Settings</title>
</head>
<body class="bg-gray-50 min-h-screen">
    <main class="flex-1 p-8">
        <!-- Header -->
        <header class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-700">Settings</h1>
                <p class="text-sm text-gray-500">Manage User Roles</p>
            </div>
            <a href="/Products/Dashboard" class="bg-teal-600 text-white px-4 py-2 rounded-md hover:bg-teal-700">
                Back to Dashboard
            </a>
        </header>

        <!-- Loading State -->
        <div id="loadingState" class="text-center py-8 hidden">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-teal-600 mx-auto mb-4"></div>
            <p class="text-gray-600">Loading users...</p>
        </div>

        <!-- Authentication Error State -->
        <div id="authError" class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6 hidden">
            <div class="flex items-center">
                <div class="text-red-600 mr-3">⚠️</div>
                <div>
                    <h3 class="text-sm font-medium text-red-800">Authentication Required</h3>
                    <p class="text-sm text-red-700 mt-1">You need to login to access user management.</p>
                </div>
            </div>
        </div>

        <!-- User Role Management -->
        <section class="bg-white shadow rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">User Roles</h2>
            <p class="text-sm text-gray-500 mb-4">View and manage user roles in the system. Only administrators can assign admin roles.</p>

            <!-- Stats Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <div class="bg-blue-50 p-4 rounded-lg">
                    <h3 class="text-sm text-blue-600">Total Users</h3>
                    <p id="totalUsers" class="text-2xl font-bold text-blue-700">Loading...</p>
                </div>
                <div class="bg-green-50 p-4 rounded-lg">
                    <h3 class="text-sm text-green-600">Admin Users</h3>
                    <p id="adminUsers" class="text-2xl font-bold text-green-700">Loading...</p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg">
                    <h3 class="text-sm text-gray-600">Regular Users</h3>
                    <p id="regularUsers" class="text-2xl font-bold text-gray-700">Loading...</p>
                </div>
            </div>

            <!-- User Table -->
            <div class="overflow-x-auto">
                <table class="w-full border border-gray-200 rounded-lg overflow-hidden">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="p-3 text-left text-gray-500 text-sm">NO</th>
                            <th class="p-3 text-left text-gray-500 text-sm">Username</th>
                            <th class="p-3 text-left text-gray-500 text-sm">Email</th>
                            <th class="p-3 text-center text-gray-500 text-sm">Role</th>
                            <th class="p-3 text-center text-gray-500 text-sm">Created</th>
                            <th class="p-3 text-center text-gray-500 text-sm">Action</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody" class="divide-y divide-gray-200">
                        <!-- Data rows will be dynamically inserted here -->
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="text-center py-8 hidden">
                <div class="text-gray-400 text-4xl mb-4">👥</div>
                <h3 class="text-lg font-semibold text-gray-600 mb-2">No Users Found</h3>
                <p class="text-gray-500">There are no users in the system.</p>
            </div>
        </section>
    </main>

    <!-- Assign Admin Confirmation Modal -->
    <div id="assignAdminModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white max-w-md w-full rounded-lg p-6 shadow-lg">
            <h2 class="text-lg font-semibold text-gray-700 mb-4 text-center">Confirm Role Change</h2>
            <p class="text-sm text-center text-gray-500 mb-6">
                Are you sure you want to assign <span id="selectedUserName" class="font-medium text-gray-800"></span> as an Admin?
                They will have the same permissions as you.
            </p>
            <div class="flex justify-center space-x-4">
                <button type="button" id="closeAssignAdminModal"
                        class="px-4 py-2 text-sm text-gray-500 border border-gray-300 rounded-md hover:bg-gray-100">
                    Cancel
                </button>
                <button type="button" id="confirmAssignButton"
                        class="px-4 py-2 text-sm bg-teal-600 text-white rounded-md hover:bg-teal-700">
                    Assign Admin
                </button>
            </div>
        </div>
    </div>

    <!-- Remove Admin Modal -->
    <div id="removeAdminModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white max-w-md w-full rounded-lg p-6 shadow-lg">
            <h2 class="text-lg font-semibold text-gray-700 mb-4 text-center">Remove Admin Role</h2>
            <p class="text-sm text-center text-gray-500 mb-6">
                Are you sure you want to remove admin role from <span id="selectedRemoveUserName" class="font-medium text-gray-800"></span>?
                They will become a regular user.
            </p>
            <div class="flex justify-center space-x-4">
                <button type="button" id="closeRemoveAdminModal"
                        class="px-4 py-2 text-sm text-gray-500 border border-gray-300 rounded-md hover:bg-gray-100">
                    Cancel
                </button>
                <button type="button" id="confirmRemoveButton"
                        class="px-4 py-2 text-sm bg-red-600 text-white rounded-md hover:bg-red-700">
                    Remove Admin
                </button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const userTableBody = document.getElementById("userTableBody");
            const loadingState = document.getElementById("loadingState");
            const emptyState = document.getElementById("emptyState");
            const authError = document.getElementById("authError");
            const apiUrl = "/api/users";
            let selectedUserId = null;
            let users = [];
            let currentUserRole = null;

            // ========================
            // JWT AUTHENTICATION HELPERS
            // ========================
            function getAuthToken() {
                return localStorage.getItem('authToken');
            }

            function getAuthHeaders() {
                const token = getAuthToken();
                return {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                };
            }

            function checkAuthentication() {
                const token = getAuthToken();
                if (!token) {
                    console.log('❌ No auth token found');
                    showAuthError();
                    return false;
                }
                return true;
            }

            function showAuthError() {
                authError.classList.remove('hidden');
                setTimeout(() => {
                    window.location.href = '/Account/Login';
                }, 3000);
            }

            // ========================
            // INITIALIZE PAGE
            // ========================
            init();

            async function init() {
                console.log('🚀 Initializing Settings page...');

                if (!checkAuthentication()) return;

                // Get current user info first
                await getCurrentUserRole();
                await fetchUsers();
                await fetchUserStats();
                setupEventListeners();
            }

            // ========================
            // GET CURRENT USER ROLE
            // ========================
            async function getCurrentUserRole() {
                try {
                    const response = await fetch('/api/users/current', {
                        headers: getAuthHeaders()
                    });

                    if (response.status === 401) {
                        showAuthError();
                        return;
                    }

                    if (response.ok) {
                        const data = await response.json();
                        if (data.success && data.user) {
                            currentUserRole = data.user.userRole;
                            console.log('Current user role:', currentUserRole);

                            // Show warning if not admin
                            if (currentUserRole !== 'Admin') {
                                showWarning('You need admin privileges to manage user roles.');
                            }
                        }
                    }
                } catch (error) {
                    console.error('Error getting current user role:', error);
                }
            }

            // ========================
            // FETCH USERS - WITH JWT
            // ========================
            async function fetchUsers() {
                try {
                    console.log('📋 Fetching users...');
                    showLoading(true);

                    const response = await fetch(apiUrl, {
                        headers: getAuthHeaders()
                    });

                    if (response.status === 401) {
                        showAuthError();
                        return;
                    }

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}: ${await response.text()}`);
                    }

                    users = await response.json();
                    console.log(`✅ Retrieved ${users.length} users`);
                    renderUserTable(users);
                    showLoading(false);

                } catch (error) {
                    console.error("❌ Error fetching users:", error);
                    showError("Failed to load user data. Please try again.");
                    showLoading(false);
                }
            }

            // ========================
            // FETCH USER STATS - WITH JWT
            // ========================
            async function fetchUserStats() {
                try {
                    console.log('📊 Fetching user stats...');

                    const response = await fetch("/api/users/stats", {
                        headers: getAuthHeaders()
                    });

                    if (response.ok) {
                        const stats = await response.json();
                        document.getElementById("totalUsers").textContent = stats.totalUsers || 0;
                        document.getElementById("adminUsers").textContent = stats.adminUsers || 0;
                        document.getElementById("regularUsers").textContent = stats.regularUsers || 0;
                        console.log('✅ Stats updated:', stats);
                    } else {
                        // Fallback calculation if stats endpoint fails
                        if (users.length > 0) {
                            const adminCount = users.filter(u => u.role === "Admin").length;
                            document.getElementById("totalUsers").textContent = users.length;
                            document.getElementById("adminUsers").textContent = adminCount;
                            document.getElementById("regularUsers").textContent = users.length - adminCount;
                        }
                    }
                } catch (error) {
                    console.error("❌ Error fetching user stats:", error);
                    // Set default values
                    document.getElementById("totalUsers").textContent = users.length;
                    document.getElementById("adminUsers").textContent = users.filter(u => u.role === "Admin").length;
                    document.getElementById("regularUsers").textContent = users.filter(u => u.role !== "Admin").length;
                }
            }

            // ========================
            // RENDER USER TABLE
            // ========================
            function renderUserTable(users) {
                if (!users || users.length === 0) {
                    userTableBody.innerHTML = "";
                    emptyState.classList.remove("hidden");
                    return;
                }

                emptyState.classList.add("hidden");
                userTableBody.innerHTML = "";

                users.forEach((user, index) => {
                    const userRow = document.createElement("tr");
                    userRow.className = "hover:bg-gray-50";

                    userRow.innerHTML = `
                        <td class="p-3 text-sm text-gray-600">${index + 1}</td>
                        <td class="p-3 text-sm text-gray-600 font-medium">${user.username || 'N/A'}</td>
                        <td class="p-3 text-sm text-gray-600">${user.email || 'N/A'}</td>
                        <td class="p-3 text-center">
                            <span class="px-3 py-1 rounded-full text-xs font-medium ${user.role === "Admin"
                                ? "bg-green-100 text-green-800"
                                : "bg-gray-100 text-gray-800"
                            }">
                                ${user.role || 'User'}
                            </span>
                        </td>
                        <td class="p-3 text-center text-sm text-gray-500">
                            ${user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'N/A'}
                        </td>
                        <td class="p-3 text-center">
                            ${renderActionButtons(user)}
                        </td>
                    `;
                    userTableBody.appendChild(userRow);
                });
                bindActionButtons();
            }

            // ========================
            // RENDER ACTION BUTTONS
            // ========================
            function renderActionButtons(user) {
                // Only show action buttons if current user is admin
                if (currentUserRole !== 'Admin') {
                    return '<span class="text-xs text-gray-400">No permission</span>';
                }

                if (user.role === "Admin") {
                    return `
                        <div class="flex justify-center space-x-2">
                            <span class="px-3 py-1 text-xs bg-green-100 text-green-600 rounded-md">
                                Admin
                            </span>
                            <button class="removeAdminButton px-3 py-1 text-xs bg-red-500 text-white rounded-md hover:bg-red-600"
                                    data-id="${user.id}" data-username="${user.username}">
                                Remove
                            </button>
                        </div>
                    `;
                } else {
                    return `
                        <button class="assignAdminButton px-4 py-2 text-white bg-teal-600 rounded-md text-sm hover:bg-teal-700"
                                data-id="${user.id}" data-username="${user.username}">
                            Assign Admin
                        </button>
                    `;
                }
            }

            // ========================
            // BIND ACTION BUTTONS
            // ========================
            function bindActionButtons() {
                // Assign Admin buttons
                const assignAdminButtons = document.querySelectorAll(".assignAdminButton");
                assignAdminButtons.forEach(button => {
                    button.addEventListener("click", function () {
                        selectedUserId = this.dataset.id;
                        const username = this.dataset.username;
                        document.getElementById("selectedUserName").textContent = username;
                        document.getElementById("assignAdminModal").classList.remove("hidden");
                    });
                });

                // Remove Admin buttons
                const removeAdminButtons = document.querySelectorAll(".removeAdminButton");
                removeAdminButtons.forEach(button => {
                    button.addEventListener("click", function () {
                        selectedUserId = this.dataset.id;
                        const username = this.dataset.username;
                        document.getElementById("selectedRemoveUserName").textContent = username;
                        document.getElementById("removeAdminModal").classList.remove("hidden");
                    });
                });
            }

            // ========================
            // SETUP EVENT LISTENERS
            // ========================
            function setupEventListeners() {
                // Assign Admin Modal
                document.getElementById("closeAssignAdminModal").addEventListener("click", () => {
                    document.getElementById("assignAdminModal").classList.add("hidden");
                    selectedUserId = null;
                });

                document.getElementById("confirmAssignButton").addEventListener("click", async () => {
                    if (selectedUserId) {
                        await assignAdminRole(selectedUserId);
                    }
                });

                // Remove Admin Modal
                document.getElementById("closeRemoveAdminModal").addEventListener("click", () => {
                    document.getElementById("removeAdminModal").classList.add("hidden");
                    selectedUserId = null;
                });

                document.getElementById("confirmRemoveButton").addEventListener("click", async () => {
                    if (selectedUserId) {
                        await removeAdminRole(selectedUserId);
                    }
                });

                // Close modals when clicking outside
                document.getElementById("assignAdminModal").addEventListener("click", (e) => {
                    if (e.target === e.currentTarget) {
                        e.currentTarget.classList.add("hidden");
                    }
                });

                document.getElementById("removeAdminModal").addEventListener("click", (e) => {
                    if (e.target === e.currentTarget) {
                        e.currentTarget.classList.add("hidden");
                    }
                });
            }

            // ========================
            // ASSIGN ADMIN ROLE - WITH JWT
            // ========================
            async function assignAdminRole(userId) {
                try {
                    console.log('🔧 Assigning admin role to user:', userId);

                    const response = await fetch(`/api/users/assign-admin/${userId}`, {
                        method: "PUT",
                        headers: getAuthHeaders()
                    });

                    if (response.status === 401) {
                        showAuthError();
                        return;
                    }

                    if (response.status === 403) {
                        showError("You don't have permission to assign admin roles.");
                        return;
                    }

                    if (!response.ok) {
                        const errorData = await response.json();
                        throw new Error(errorData.message || "Failed to assign admin role");
                    }

                    const result = await response.json();
                    showSuccess(result.message);

                    // Close modal and refresh data
                    document.getElementById("assignAdminModal").classList.add("hidden");
                    selectedUserId = null;
                    await fetchUsers();
                    await fetchUserStats();

                } catch (error) {
                    console.error("❌ Error assigning admin role:", error);
                    showError("Failed to assign admin role: " + error.message);
                }
            }

            // ========================
            // REMOVE ADMIN ROLE - WITH JWT
            // ========================
            async function removeAdminRole(userId) {
                try {
                    console.log('🔧 Removing admin role from user:', userId);

                    const response = await fetch(`/api/users/remove-admin/${userId}`, {
                        method: "PUT",
                        headers: getAuthHeaders()
                    });

                    if (response.status === 401) {
                        showAuthError();
                        return;
                    }

                    if (response.status === 403) {
                        showError("You don't have permission to remove admin roles.");
                        return;
                    }

                    if (!response.ok) {
                        const errorData = await response.json();
                        throw new Error(errorData.message || "Failed to remove admin role");
                    }

                    const result = await response.json();
                    showSuccess(result.message);

                    // Close modal and refresh data
                    document.getElementById("removeAdminModal").classList.add("hidden");
                    selectedUserId = null;
                    await fetchUsers();
                    await fetchUserStats();

                } catch (error) {
                    console.error("❌ Error removing admin role:", error);
                    showError("Failed to remove admin role: " + error.message);
                }
            }

            // ========================
            // UTILITY FUNCTIONS
            // ========================
            function showLoading(show) {
                loadingState.classList.toggle("hidden", !show);
            }

            function showError(message) {
                const toast = createToast(message, 'error');
                document.body.appendChild(toast);
            }

            function showSuccess(message) {
                const toast = createToast(message, 'success');
                document.body.appendChild(toast);
            }

            function showWarning(message) {
                const toast = createToast(message, 'warning');
                document.body.appendChild(toast);
            }

            function createToast(message, type) {
                const toast = document.createElement('div');
                let bgColor = 'bg-red-500';

                if (type === 'success') bgColor = 'bg-green-500';
                else if (type === 'warning') bgColor = 'bg-yellow-500';

                toast.className = `fixed top-4 right-4 p-4 rounded-md shadow-lg z-50 ${bgColor} text-white max-w-sm`;
                toast.textContent = message;

                setTimeout(() => {
                    toast.remove();
                }, 5000);

                return toast;
            }
        });
    </script>
</body>
</html>