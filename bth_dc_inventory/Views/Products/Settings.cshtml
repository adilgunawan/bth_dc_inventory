@{
    ViewData["Title"] = "Settings ";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
    <main class="flex-1 p-8">
    <!-- Header -->
    <header class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-700">Settings</h1>
            <p class="text-sm text-gray-500">Manage User Roles</p>
        </div>
        
        <a asp-controller="Products" asp-action="Dashboard" class="bg-teal-600 text-white px-4 py-2 rounded-md hover:bg-teal-700">
            Detail Product
        </a>
    </header>

    <!-- User Role Management -->
    <section class="bg-white shadow rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">User Roles</h2>
        <p class="text-sm text-gray-500 mb-4">View and manage user roles in the system. Assign a user as an Admin if needed.</p>


        <!-- User Table 2-->
        <table class="w-full border border-gray-200 rounded-lg overflow-hidden">
            <thead class="bg-gray-100">
                <tr>
                    <th class="p-3 text-left text-gray-500 text-sm">NO</th>
                    <th class="p-3 text-left text-gray-500 text-sm">Username</th>
                    <th class="p-3 text-left text-gray-500 text-sm">Email</th>
                    <th class="p-3 text-center text-gray-500 text-sm">Role</th>
                    <th class="p-3 text-center text-gray-500 text-sm">Action</th>
                </tr>
            </thead>
            <tbody id="userTableBody" class="divide-y divide-gray-200">
                <!-- Data rows will be dynamically inserted here -->
            </tbody>
        </table>
    </section>
    <!-- Assign Admin Confirmation Modal -->
    <div id="assignAdminModal" class="fixed inset-0 bg-black/30 flex justify-center items-center hidden z-50">
        <div class="bg-white max-w-sm w-full rounded-lg p-6 shadow-lg">
            <h2 class="text-lg font-semibold text-gray-700 mb-4 text-center">Confirm Role Change</h2>
            <p class="text-sm text-center text-gray-500 mb-6">
                Are you sure you want to assign <span id="selectedUserName" class="font-medium text-gray-800"></span> as an Admin?
                They will have the same permissions as you.
            </p>
            <div class="flex justify-center space-x-4">
                <button type="button" id="closeAssignAdminModal" class="px-4 py-2 text-sm text-gray-500 border border-gray-300 rounded-md hover:bg-gray-100">
                    Cancel
                </button>
                <button type="button" id="confirmAssignButton" class="px-4 py-2 text-sm bg-teal-600 text-white rounded-md hover:bg-teal-700">
                    Assign Admin
                </button>
            </div>
        </div>
    </div>

  <script>
            // Referensi elemen modal
        const assignAdminModal = document.getElementById("assignAdminModal");
        const closeAssignAdminModalButton = document.getElementById("closeAssignAdminModal");
        const confirmAssignAdminButton = document.getElementById("confirmAssignAdmin");

        // Tombol yang akan membuka modal (tambah ke tabel atau elemen lain)
        const assignButtons = document.querySelectorAll(".assignAdminButton");

        // Event untuk membuka modal
        assignButtons.forEach((btn) => {
            btn.addEventListener("click", function () {
                const userName = this.getAttribute("data-user-name"); // Ambil nama user dari atribut data
                const selectedUserName = document.getElementById("selectedUserName"); // Referensi elemen di modal
                selectedUserName.textContent = userName; // Tampilkan nama user di modal
                assignAdminModal.classList.remove("hidden"); // Tampilkan modal
            });
        });

        // Event untuk menutup modal (jika tombol Cancel ditekan)
        closeAssignAdminModalButton.addEventListener("click", function () {
            assignAdminModal.classList.add("hidden"); // Sembunyikan modal
        });

        // Event saat tombol Confirm ditekan (hanya placeholder untuk sekarang)
        confirmAssignAdminButton.addEventListener("click", function () {
            alert("Role has been changed to Admin!"); // Contoh pesan (sesuaikan nanti)
            assignAdminModal.classList.add("hidden"); // Sembunyikan modal setelah aksi
        });
  </script>

</main>
<script>
        document.addEventListener("DOMContentLoaded", function () {
        const userTableBody = document.getElementById("userTableBody");
        const apiUrl = "https://localhost:7035/api/users"; // Sesuaikan dengan URL backend Anda

        // Fetch users from API
        function fetchUsers() {
            fetch(apiUrl)
                .then((response) => {
                    if (!response.ok) {
                        throw new Error("Failed to fetch user data");
                    }
                    return response.json();
                })
                .then((data) => {
                    console.log("Users fetched:", data); // Debugging log
                    renderUserTable(data); // Render data to table
                })
                .catch((error) => {
                    console.error("Error:", error);
                    alert("Failed to load user data. Please try again.");
                });
        }

        // Render data ke tabel
        function renderUserTable(users) {
            userTableBody.innerHTML = ""; // Kosongkan tabel
            users.forEach((user, index) => {
                const userRow = `
                    <tr>
                        <td class="p-3 text-sm text-gray-600">${index + 1}</td>
                        <td class="p-3 text-sm text-gray-600">${user.username}</td>
                        <td class="p-3 text-sm text-gray-600">${user.email}</td>
                        <td class="p-3 text-center">
                            <span class="px-3 py-1 rounded-full text-xs ${
                                user.role === "Admin" ? "bg-green-100 text-green-800" : "bg-gray-200 text-gray-800"
                            }">
                                ${user.role}
                            </span>
                        </td>
                        <td class="p-3 text-center">
                            ${
                                user.role === "Admin"
                                    ? `<button disabled class="px-4 py-2 text-white bg-gray-300 rounded-md text-sm cursor-not-allowed">
                                           Admin
                                       </button>`
                                    : `<button class="assignAdminButton px-4 py-2 text-white bg-teal-600 rounded-md text-sm hover:bg-teal-700" data-id="${user.id}">
                                           Assign Admin
                                       </button>`
                            }
                        </td>
                    </tr>
                `;
                userTableBody.insertAdjacentHTML("beforeend", userRow);
            });

            // Tambahkan event listener ke tombol assign admin
            bindAssignAdminButtons();
        }

        // Tambahkan logika untuk tombol Assign Admin
        function bindAssignAdminButtons() {
            const assignAdminButtons = document.querySelectorAll(".assignAdminButton");
            assignAdminButtons.forEach((button) => {
                button.addEventListener("click", function () {
                    const userId = this.dataset.id;
                    assignAdminRole(userId);
                });
            });
        }

        // Function untuk memberikan role admin
        function assignAdminRole(userId) {
            const assignAdminApiUrl = `https://localhost:7035/api/users/assign-admin/${userId}`; // Sesuaikan endpoint assign admin

            fetch(assignAdminApiUrl, {
                method: "PUT",
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error("Failed to assign admin role");
                    }
                    return response.json();
                })
                .then(() => {
                    alert("User has been assigned as Admin.");
                    fetchUsers(); // Refresh tabel setelah update
                })
                .catch((error) => {
                    console.error("Error:", error);
                    alert("Failed to assign admin role. Please try again.");
                });
        }

        // Inisialisasi: Fetch data pengguna saat halaman dimuat
        fetchUsers();
    });
</script>
</html>