<div class="w-full bg-white shadow-md flex items-center justify-between px-6 py-4 gap-3">
    <!-- Left: Empty / Bisa isi nanti -->
    <div></div>

    <!-- Center Logo -->
    <div class="flex items-center gap-3 py-2">
        <img src="~/images/logo-infineon.jpg" class="h-12" />
    </div>

    <!-- Right Profile -->
    <!-- ✅ Update bagian profile untuk handle guest users -->
    <div class="flex items-center gap-3">
        <div class="flex items-center gap-2">
            <!-- ✅ Dynamic User Avatar -->
            <div id="userAvatar" class="w-10 h-10 bg-teal-600 text-white flex items-center justify-center rounded-full font-bold">
                ?
            </div>
            <div class="leading-tight">
                <!-- ✅ Dynamic Username -->
                <p id="userName" class="font-semibold text-sm">Loading...</p>
                <!-- ✅ Dynamic User Role -->
                <p id="userRole" class="text-xs text-gray-400">Data Center Inventory</p>
            </div>

            <!-- ✅ Conditional buttons based on auth status -->
            <div id="authButtons" class="flex items-center gap-2">
                <!-- ✅ Logout Button (hidden for guests) -->
                <button id="logoutButton" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition-colors">
                    Logout
                </button>

                <!-- ✅ Login Button (shown for guests) -->
                <button id="loginButton" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-colors hidden"
                        onclick="window.location.href='/Account/Login'">
                    Login
                </button>
            </div>
        </div>
    </div>

    <!-- ✅ Custom Confirmation Modal -->
    <div id="logoutModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-lg shadow-lg p-6 max-w-sm w-full mx-4">
            <div class="flex items-center mb-4">
                <div class="flex-shrink-0">
                    <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-lg font-medium text-gray-900">
                        Confirm Logout
                    </h3>
                </div>
            </div>
            <div class="mb-4">
                <p class="text-sm text-gray-500">
                    Are you sure you want to logout from your account?
                </p>
            </div>
            <div class="flex justify-end space-x-3">
                <button id="cancelLogout" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-200 hover:bg-gray-300 rounded-md transition-colors">
                    Cancel
                </button>
                <button id="confirmLogout" class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-md transition-colors">
                    Logout
                </button>
            </div>
        </div>
    </div>
    <script>
                // ✅ Di function updateUserDisplay, tambahkan:
        function updateUserDisplay(userName, userEmail, userRole) {
            // ... existing code ...

            // ✅ Show/hide buttons based on authentication
            const logoutButton = document.getElementById('logoutButton');
            const loginButton = document.getElementById('loginButton');

            if (userName === 'Guest User' || userRole === 'Visitor') {
                // Guest user - show login button, hide logout
                logoutButton?.classList.add('hidden');
                loginButton?.classList.remove('hidden');
            } else {
                // Authenticated user - show logout button, hide login
                logoutButton?.classList.remove('hidden');
                loginButton?.classList.add('hidden');
            }

            console.log('✅ User display updated successfully');
        }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            loadUserProfile();
            setupLogout();
        });

        // =====================================
        // JWT HELPER FUNCTIONS - ✅ KONSISTEN DENGAN DASHBOARD
        // =====================================
        function getAuthToken() {
            return localStorage.getItem('authToken'); // ✅ Gunakan 'authToken' bukan 'token'
        }

        function getAuthHeaders() {
            const token = getAuthToken();
            return {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            };
        }

        function checkAuthentication() {
            const token = getAuthToken();
            if (!token) {
                console.log('❌ No auth token found');
                return false;
            }
            return true;
        }

        // =====================================
        // LOAD USER PROFILE - ✅ DIPERBAIKI
        // =====================================
        async function loadUserProfile() {
            try {
                console.log('🔄 Loading user profile...');

                // ✅ Cek token dulu
                if (!checkAuthentication()) {
                    console.log('No authentication found, using guest mode');
                    updateUserDisplay('Guest User', '', 'Visitor');
                    return;
                }

                // ✅ Ambil dari localStorage dulu untuk display cepat
                const userName = localStorage.getItem('userName');
                const userEmail = localStorage.getItem('userEmail');
                const userRole = localStorage.getItem('userRole');

                if (userName) {
                    console.log('✅ Found user in localStorage:', userName);
                    updateUserDisplay(userName, userEmail, userRole);
                }

                // ✅ Verify dengan server
                await verifyTokenValidity();

            } catch (error) {
                console.error('❌ Error in loadUserProfile:', error);
                updateUserDisplay('Guest User', '', 'Visitor');
            }
        }

        // =====================================
        // VERIFY TOKEN VALIDITY - ✅ DIPERBAIKI
        // =====================================
        async function verifyTokenValidity() {
            try {
                console.log('🔍 Verifying token validity...');

                const response = await fetch('/api/users/current', {
                    method: 'GET',
                    headers: getAuthHeaders()
                });

                console.log('Token verification response status:', response.status);

                if (!response.ok) {
                    if (response.status === 401) {
                        console.log('❌ Token expired/invalid, clearing user data');
                        clearUserData();
                        updateUserDisplay('Guest User', '', 'Visitor');
                        return;
                    }
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();
                console.log('✅ Token verification result:', result);

                if (result.success && result.user) {
                    // ✅ Update dengan data terbaru dari server
                    const user = result.user;
                    localStorage.setItem('userName', user.userName);
                    localStorage.setItem('userEmail', user.userEmail);
                    localStorage.setItem('userRole', user.userRole);

                    updateUserDisplay(user.userName, user.userEmail, user.userRole);
                    console.log('✅ User profile updated from server');
                }

            } catch (error) {
                console.error('❌ Error verifying token:', error);
                // Don't clear data on network errors, keep localStorage data
            }
        }

        // =====================================
        // UPDATE USER DISPLAY - ✅ ENHANCED
        // =====================================
        function updateUserDisplay(userName, userEmail, userRole) {
            console.log(`🎨 Updating display for: ${userName} (${userRole})`);

            try {
                // ✅ Update username
                const userNameElement = document.getElementById('userName');
                if (userNameElement) {
                    userNameElement.textContent = userName || 'Guest';
                    if (userEmail) {
                        userNameElement.title = `${userName} (${userEmail})`; // Tooltip with email
                    }
                }

                // ✅ Update role
                const userRoleElement = document.getElementById('userRole');
                if (userRoleElement) {
                    if (userRole && userRole !== 'Visitor') {
                        userRoleElement.textContent = userRole;
                    } else {
                        userRoleElement.textContent = 'Data Center Inventory';
                    }
                }

                // ✅ Update avatar
                const userAvatar = document.getElementById('userAvatar');
                if (userAvatar && userName) {
                    const initial = userName.charAt(0).toUpperCase();
                    userAvatar.textContent = initial;

                    // ✅ Warna berdasarkan role
                    let colorClass = 'bg-teal-600'; // Default
                    if (userRole === 'Admin') {
                        colorClass = 'bg-red-600';
                    } else if (userRole === 'User') {
                        colorClass = 'bg-blue-600';
                    } else if (userRole === 'Visitor') {
                        colorClass = 'bg-gray-600';
                    }

                    userAvatar.className = `w-10 h-10 ${colorClass} text-white flex items-center justify-center rounded-full font-bold`;
                }

                // ✅ Show/hide logout button based on authentication
                const logoutButton = document.getElementById('logoutButton');
                if (logoutButton) {
                    if (userName === 'Guest User' || userRole === 'Visitor') {
                        logoutButton.style.display = 'none';
                    } else {
                        logoutButton.style.display = 'block';
                    }
                }

                console.log('✅ User display updated successfully');

            } catch (error) {
                console.error('❌ Error updating user display:', error);
            }
        }

        // =====================================
        // SETUP LOGOUT - ✅ ENHANCED
        // =====================================
        function setupLogout() {
            const logoutButton = document.getElementById('logoutButton');
            const logoutModal = document.getElementById('logoutModal');
            const cancelLogout = document.getElementById('cancelLogout');
            const confirmLogout = document.getElementById('confirmLogout');

            // ✅ Show modal on logout click
            logoutButton?.addEventListener('click', () => {
                logoutModal.classList.remove('hidden');
            });

            // ✅ Cancel logout
            cancelLogout?.addEventListener('click', () => {
                logoutModal.classList.add('hidden');
            });

            // ✅ Close modal on backdrop click
            logoutModal?.addEventListener('click', (e) => {
                if (e.target === logoutModal) {
                    logoutModal.classList.add('hidden');
                }
            });

            // ✅ Confirm logout
            confirmLogout?.addEventListener('click', async () => {
                await performLogout();
            });

            // ✅ Close on Escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !logoutModal?.classList.contains('hidden')) {
                    logoutModal.classList.add('hidden');
                }
            });
        }

        // =====================================
        // PERFORM LOGOUT - ✅ ENHANCED
        // =====================================
        async function performLogout() {
            try {
                const confirmButton = document.getElementById('confirmLogout');
                const originalText = confirmButton.textContent;

                // ✅ Show loading state
                confirmButton.textContent = 'Logging out...';
                confirmButton.disabled = true;

                console.log('🚪 Performing logout...');

                // ✅ Call server logout endpoint if token exists
                const token = getAuthToken();
                if (token) {
                    try {
                        const response = await fetch('/api/users/logout', {
                            method: 'POST',
                            headers: getAuthHeaders()
                        });
                        console.log('Server logout response:', response.status);
                    } catch (serverError) {
                        console.warn('⚠️ Server logout failed (but continuing):', serverError);
                    }
                }

                // ✅ Clear all user data
                clearUserData();

                console.log('✅ User data cleared, redirecting to login...');

                // ✅ Redirect to login page
                window.location.href = "/Account/Login"; // ✅ Capital L untuk consistency

            } catch (error) {
                console.error('❌ Logout error:', error);

                // ✅ Reset button state
                const confirmButton = document.getElementById('confirmLogout');
                confirmButton.textContent = 'Logout';
                confirmButton.disabled = false;

                alert('Logout may have failed, but you will be redirected to login page.');
                clearUserData();
                window.location.href = "/Account/Login";
            }
        }

        // =====================================
        // CLEAR USER DATA - ✅ COMPREHENSIVE
        // =====================================
        function clearUserData() {
            // ✅ Clear all possible token keys (for consistency)
            localStorage.removeItem('authToken'); // ✅ Primary token key
            localStorage.removeItem('token');     // ✅ Legacy token key
            localStorage.removeItem('userName');
            localStorage.removeItem('userEmail');
            localStorage.removeItem('userRole');

            console.log('🧹 All user data cleared from localStorage');
        }

        // =====================================
        // MAKE FUNCTIONS AVAILABLE GLOBALLY - ✅ OPTIONAL
        // =====================================
        window.loadUserProfile = loadUserProfile;
        window.performLogout = performLogout;
    </script>
</div>